{
  "schema": {
    "schema_name": "PLA Timeline Schema v1.0",
    "module": "pla_timeline",
    "id_prefix": "TIM-",
    "description": "解放軍視角之逐時時間軸（1949-10-24 至 1949-10-27），與現有 ROC 時間軸區分",
    "fields": {
      "timeline_id": {
        "type": "string",
        "required": true,
        "pattern": "TIM-XXXX"
      },
      "date": {
        "type": "string",
        "required": true,
        "format": "YYYY-MM-DD"
      },
      "time": {
        "type": "string",
        "required": false,
        "description": "HH:MM 或文字描述"
      },
      "time_approximate": {
        "type": "boolean",
        "required": false,
        "default": true
      },
      "event_summary_zh_cn": {
        "type": "string",
        "required": true
      },
      "event_summary_zh_tw": {
        "type": "string",
        "required": false
      },
      "location": {
        "type": "string",
        "required": true
      },
      "location_from_pla": {
        "type": "string",
        "required": false,
        "description": "解放軍稱呼之地名"
      },
      "involved_pla_forces": {
        "type": "array",
        "required": false,
        "items": {
          "type": "string",
          "description": "OOB-XXXX"
        }
      },
      "involved_roc_forces": {
        "type": "array",
        "required": false,
        "items": {
          "type": "string"
        }
      },
      "key_pla_figures": {
        "type": "array",
        "required": false,
        "items": {
          "type": "string",
          "description": "PER-XXXX"
        }
      },
      "event_type": {
        "type": "string",
        "required": true,
        "enum": [
          "集結",
          "出航",
          "登陸",
          "推進",
          "戰鬥",
          "反擊",
          "防禦",
          "撤退",
          "潰散",
          "指揮決策",
          "補給",
          "通訊",
          "戰後"
        ]
      },
      "pla_description": {
        "type": "string",
        "required": true,
        "description": "解放軍視角之事件描述"
      },
      "roc_comparison_note": {
        "type": "string",
        "required": false,
        "description": "與 ROC 版本之差異備註"
      },
      "source_ids": {
        "type": "array",
        "required": true,
        "items": {
          "type": "string",
          "description": "LIT-XXXX"
        }
      },
      "citation_excerpts": {
        "type": "array",
        "required": false,
        "items": {
          "type": "string"
        }
      },
      "verification_status": {
        "type": "string",
        "required": true,
        "enum": [
          "verified",
          "partially_verified",
          "conflicting_sources",
          "needs_human_review",
          "prc_only"
        ]
      },
      "has_comparison": {
        "type": "boolean",
        "required": true,
        "default": false,
        "description": "是否有對應之 CMP 比較紀錄"
      }
    }
  },
  "entries": [
    {
