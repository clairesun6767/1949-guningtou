      "date": "1949-10-24",
      "time": "傍晚",
      "time_approximate": true,
      "event_summary_zh_cn": "第28军各第一梯队团在莲河、大嶝岛、小嶝岛等地登船完毕",
      "location": "莲河、大嶝岛、小嶝岛",
      "location_from_pla": "莲河、大嶝岛、小嶝岛",
      "involved_pla_forces": [
        "OOB-0004",
        "OOB-0005",
        "OOB-0006"
      ],
      "event_type": "集結",
      "pla_description": "解放军第28军第82师第244、245、246团在莲河至大嶝岛一线完成登船，准备渡海进攻金门。"
    },
    {
      "timeline_id": "TIM-0024-02",
      "date": "1949-10-24",
      "time": "21:00后",
      "time_approximate": true,
      "event_summary_zh_cn": "船队出发，向金门古宁头方向航行",
      "location": "莲河至古宁头海域",
      "involved_pla_forces": [
        "OOB-0004",
        "OOB-0005",
        "OOB-0006"
      ],
      "event_type": "出航",
      "pla_description": "第一梯队船队出发。因船只不足，原定3个团约9,000人的兵力，实际登船约7,000-8,000人。"
    },
    {
      "timeline_id": "TIM-0024-03",
