---
import type { ArchiveMediaAsset } from '../../data/mediaCatalog';
import { sitePath } from '../../data/paths';

interface Props {
  asset: ArchiveMediaAsset;
  lang?: string;
  compact?: boolean;
}

const { asset, lang = 'zh-tw', compact = false } = Astro.props;
const isEnglish = lang === 'en';
const imageSrc = asset.src.startsWith('http') ? asset.src : sitePath(asset.src);
const sourceHref = asset.sourceUrl.startsWith('http') ? asset.sourceUrl : sitePath(asset.sourceUrl);
const title = isEnglish ? asset.titleEn : asset.titleZh;
const caption = isEnglish ? asset.captionEn : asset.captionZh;
const source = isEnglish ? asset.sourceEn : asset.sourceZh;
---

<article class:list={['museum-media-card', compact && 'museum-media-card--compact']}>
  <a class="museum-media-card__image" href={imageSrc} target="_blank" rel="noopener noreferrer" aria-label={isEnglish ? `Open image: ${title}` : `開啟影像：${title}`}>
    <img src={imageSrc} alt={title} loading="lazy" decoding="async" />
  </a>
  <div class="museum-media-card__body">
    <div class="museum-media-card__head">
      <span class="museum-label">{asset.kind.toUpperCase()}</span>
      {asset.status === 'research' && <span class="museum-status">{isEnglish ? 'RESEARCH' : '研究中'}</span>}
    </div>
    <h3>{title}</h3>
    <p>{caption}</p>
    <div class="museum-media-card__source">
      <a href={sourceHref} target="_blank" rel="noopener noreferrer">{source} ↗</a>
      <span>{asset.rights}</span>
    </div>
  </div>
</article>
