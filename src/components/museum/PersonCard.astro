---
import type { HistoricalPerson } from '../../data/types';
import { displayRank, displayUnit } from '../../i18n/labels';
import { getPersonCopy } from '../../i18n/historicalContent';
import { getPersonMedia } from '../../data/mediaCatalog';
import { sitePath } from '../../data/paths';

interface Props {
  person: HistoricalPerson;
  href: string;
  lang?: string;
}

const { person, href, lang = 'zh-tw' } = Astro.props;
const isEnglish = lang === 'en';
const copy = getPersonCopy(person, lang);
const portrait = getPersonMedia(person.person_id).find((asset) => asset.kind === 'portrait');
const portraitSrc = portrait ? sitePath(portrait.src) : sitePath('media/guningtou/portrait-placeholder.svg');
const portraitAlt = portrait
  ? (isEnglish ? portrait.titleEn : portrait.titleZh)
  : (isEnglish ? 'Neutral placeholder: no legally publishable portrait available' : lang === 'zh-cn' ? '中性占位图：暂无可合法公开的肖像' : '中性佔位圖：尚無可合法公開的肖像');
---

<a href={href} class="museum-card museum-card-link museum-person-card">
  <div class="museum-person-card__image">
    <img src={portraitSrc} alt={portraitAlt} loading="lazy" decoding="async" />
  </div>
  <div class="museum-person-card__top">
    <div>
      <div class="museum-kicker">{isEnglish ? 'Person record' : lang === 'zh-cn' ? '人物档案' : '人物檔案'}</div>
      <h3>{copy.name}</h3>
    </div>
    {person.evidence_level && <span class={`evidence-badge evidence-${person.evidence_level}`}>{isEnglish ? 'Evidence' : lang === 'zh-cn' ? '证据' : '證據'} {person.evidence_level}</span>}
  </div>
  <p class="museum-person-card__role">{copy.role || copy.category}</p>
  <div class="museum-meta-grid">
    <dl class="museum-meta"><dt>{isEnglish ? 'Unit' : lang === 'zh-cn' ? '单位' : '單位'}</dt><dd>{displayUnit(person.unit, lang) || '—'}</dd></dl>
    <dl class="museum-meta"><dt>{isEnglish ? 'Rank' : lang === 'zh-cn' ? '军阶' : '軍階'}</dt><dd>{displayRank(person.rank_at_event, lang) || '—'}</dd></dl>
  </div>
  <p class="museum-person-card__summary">{copy.bio}</p>
</a>
