---
import type { HistoricalPerson } from '../../data/types';
import { displayRank, displayUnit } from '../../i18n/labels';
import { getPersonMedia } from '../../data/mediaCatalog';
import { sitePath } from '../../data/paths';

interface Props {
  person: HistoricalPerson;
  href: string;
  lang?: string;
}

const { person, href, lang = 'zh-tw' } = Astro.props;
const isEnglish = lang === 'en';
const portrait = getPersonMedia(person.person_id).find((asset) => asset.kind === 'portrait');
const displayBio = isEnglish
  ? 'Canonical person record; English editorial biography pending review.'
  : person.short_bio || person.biographical_summary || '尚無摘要';
---

<a href={href} class="museum-card museum-card-link museum-person-card">
  {portrait && (
    <div class="museum-person-card__image">
      <img src={sitePath(portrait.src)} alt={isEnglish ? portrait.titleEn : portrait.titleZh} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="museum-person-card__top">
    <div>
      <div class="museum-kicker">{isEnglish ? 'Person record' : '人物檔案'}</div>
      <h3>{isEnglish ? person.name_en ?? person.name_zh : person.name_zh}</h3>
    </div>
    {person.evidence_level && <span class={`evidence-badge evidence-${person.evidence_level}`}>{isEnglish ? 'Evidence' : '證據'} {person.evidence_level}</span>}
  </div>
  <p class="museum-person-card__role">{isEnglish ? person.primary_category || 'Role pending' : person.role_in_battle || person.primary_category || '角色待補'}</p>
  <div class="museum-meta-grid">
    <dl class="museum-meta"><dt>{isEnglish ? 'Unit' : '單位'}</dt><dd>{displayUnit(person.unit, lang) || '—'}</dd></dl>
    <dl class="museum-meta"><dt>{isEnglish ? 'Rank' : '軍階'}</dt><dd>{displayRank(person.rank_at_event, lang) || '—'}</dd></dl>
  </div>
  <p class="museum-person-card__summary">{displayBio}</p>
</a>
