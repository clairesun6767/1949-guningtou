---
import '../styles/global.css';
import { sitePath, LANGS } from '../data/paths';
import { UI } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import SearchBar from '../components/shared/SearchBar';
interface Props { lang: string; title?: string; lastUpdated?: string; }
const { lang, title, lastUpdated } = Astro.props;
const t = (key: string) => UI[lang as Lang]?.[key] || UI['zh-tw']?.[key] || key;

const navGroups = [
  {
    labelKey: 'navUnderstanding' as const,
    items: [
      { href: 'context', labelKey: 'navContext' as const },
      { href: 'analysis', labelKey: 'navAnalysis' as const },
      { href: 'aftermath', labelKey: 'navAftermath' as const },
    ],
  },
  {
    labelKey: 'navBattlefield' as const,
    items: [
      { href: 'timeline', labelKey: 'navTimeline' as const },
      { href: 'map', labelKey: 'navMap' as const },
      { href: 'stories', labelKey: 'navStories' as const },
    ],
  },
  {
    labelKey: 'navPeople' as const,
    items: [
      { href: 'figures', labelKey: 'navFigures' as const },
      { href: 'locations', labelKey: 'navLocations' as const },
      { href: 'weapons', labelKey: 'navWeapons' as const },
      { href: 'artifacts', labelKey: 'navArtifacts' as const },
    ],
  },
  {
    labelKey: 'navResearch' as const,
    items: [
      { href: 'perspectives', labelKey: 'navPerspectives' as const },
      { href: 'sources', labelKey: 'navSources' as const },
      { href: 'archive', labelKey: 'navArchive' as const },
    ],
  },
  {
    labelKey: 'navPeace' as const,
    items: [
      { href: 'peace', labelKey: 'navAfterwar' as const },
      { href: 'battlefield-os', labelKey: 'navBattlefieldOS' as const },
      { href: 'about', labelKey: 'navAbout' as const },
    ],
  },
];
---

<!DOCTYPE html>
<html lang={lang === 'zh-cn' ? 'zh-Hans' : lang === 'en' ? 'en' : 'zh-Hant'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>{title ?? t('siteTitle') + ' · ' + t('siteTagline')}</title>
    <meta name="description" content={t('siteDesc')} />
    <link rel="alternate" hreflang="zh-Hant" href={sitePath('', 'zh-tw')} />
    <link rel="alternate" hreflang="zh-Hans" href={sitePath('', 'zh-cn')} />
    <link rel="alternate" hreflang="en" href={sitePath('', 'en')} />
    <link rel="alternate" hreflang="x-default" href={sitePath('', 'zh-tw')} />
    {lang === 'zh-tw' && <link rel="alternate" hreflang="zh-Hant" href={sitePath('', 'zh-tw')} />}
    {lang === 'zh-cn' && <link rel="alternate" hreflang="zh-Hans" href={sitePath('', 'zh-cn')} />}
    {lang === 'en' && <link rel="alternate" hreflang="en" href={sitePath('', 'en')} />}
  </head>
  <body class="min-h-screen flex flex-col bg-stone-50">
    <header class="bg-white/95 backdrop-blur border-b border-stone-200 sticky top-0 z-50 overflow-visible">
      <div class="max-w-7xl mx-auto px-4 h-12 flex items-center justify-between">
        <a href={sitePath('', lang)} class="font-serif font-bold text-base text-stone-800 no-underline hover:text-amber-700 transition flex items-center gap-2">
          {t('siteTitle')}
          <span class="hidden sm:inline text-xs text-stone-400 font-normal">{t('siteTagline')}</span>
        </a>
        <div class="flex items-center gap-2 text-xs">
          <SearchBar client:load />
          {LANGS.map(l => (
            <a href={sitePath(Astro.url.pathname.split('/').slice(3).join('/'), l.code)}
               class={`px-2 py-1 rounded no-underline ${l.code === lang ? 'bg-amber-100 text-amber-700 font-medium' : 'text-stone-400 hover:text-stone-600'}`}>
              {l.short}
            </a>
          ))}
        </div>
      </div>

      <nav class="max-w-7xl mx-auto px-4 pb-2 flex gap-0.5 text-[13px] overflow-visible">
        <a href={sitePath('', lang)} class="px-3 py-1.5 rounded whitespace-nowrap text-stone-500 hover:bg-stone-100 hover:text-stone-700 no-underline transition font-medium">{t('home')}</a>
        {navGroups.map(group => (
          <div class="relative group">
            <span class="px-3 py-1.5 rounded whitespace-nowrap text-stone-500 cursor-default group-hover:bg-stone-100 group-hover:text-stone-700 transition inline-block">
              {t(group.labelKey)} ▾
            </span>
            <div class="absolute top-full left-0 mt-1 bg-white border border-stone-200 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-[9999] min-w-[180px]">
              {group.items.map(item => (
                <a href={sitePath(item.href, lang)} class="block px-4 py-2.5 text-stone-600 hover:bg-amber-50 hover:text-amber-700 no-underline whitespace-nowrap first:rounded-t-lg last:rounded-b-lg text-sm">
                  {t(item.labelKey)}
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-stone-900 text-stone-400 text-sm py-8 mt-16">
      <div class="max-w-6xl mx-auto px-4 text-center space-y-2">
        <p>{t('footerPlatform')}</p>
        <p class="text-stone-500 text-xs">{t('footerSource')}</p>
        <p class="text-stone-600 text-xs mt-4">{t('footerPeace')}</p>
        {lang !== 'zh-tw' && <p class="text-amber-500 text-xs mt-2">{t('translationInProgress')}</p>}
        {lastUpdated && <p class="text-stone-500 text-xs mt-2">{t('footerUpdated')}：{lastUpdated} · {t('footerVersion')}</p>}
        <p class="text-stone-500 text-xs mt-2">
          {t('footerReport')} <a href="https://github.com/clairesun6767/1949-guningtou/issues/new?template=史料回報.yml" class="text-amber-400 hover:underline">{t('footerReportLink')}</a>
        </p>
      </div>
    </footer>
  </body>
</html>
