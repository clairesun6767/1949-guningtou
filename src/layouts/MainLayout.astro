---
import '../styles/global.css';
import { sitePath, LANGS } from '../data/paths';
import { UI } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import SearchBar from '../components/shared/SearchBar';

interface Props {
  lang: string;
  title?: string;
  lastUpdated?: string;
}

const { lang, title, lastUpdated } = Astro.props;
const typedLang = lang as Lang;
const t = (key: string) => UI[typedLang]?.[key] || UI['zh-tw']?.[key] || key;
const currentPath = Astro.url.pathname;

const navGroups: { labelKey: string; items: { href: string; labelKey: string }[] }[] = [
  {
    labelKey: 'navUnderstanding' as const,
    items: [
      { href: 'context', labelKey: 'navContext' as const },
      { href: 'analysis', labelKey: 'navAnalysis' as const },
      { href: 'aftermath', labelKey: 'navAftermath' as const },
    ],
  },
  {
    labelKey: 'navBattlefield' as const,
    items: [
      { href: 'timeline', labelKey: 'navTimeline' as const },
      { href: 'map', labelKey: 'navMap' as const },
      { href: 'stories', labelKey: 'navStories' as const },
    ],
  },
  {
    labelKey: 'navPeople' as const,
    items: [
      { href: 'figures', labelKey: 'navFigures' as const },
      { href: 'locations', labelKey: 'navLocations' as const },
      { href: 'weapons', labelKey: 'navWeapons' as const },
      { href: 'artifacts', labelKey: 'navArtifacts' as const },
    ],
  },
  {
    labelKey: 'navResearch' as const,
    items: [
      { href: 'perspectives', labelKey: 'navPerspectives' as const },
      { href: 'sources', labelKey: 'navSources' as const },
      { href: 'archive', labelKey: 'navArchive' as const },
    ],
  },
  {
    labelKey: 'navPeace' as const,
    items: [
      { href: 'peace', labelKey: 'navAfterwar' as const },
      { href: 'battlefield-os', labelKey: 'navBattlefieldOS' as const },
      { href: 'about', labelKey: 'navAbout' as const },
    ],
  },
];

function pathFor(href: string) {
  return sitePath(href, lang);
}

function isCurrent(href: string) {
  if (!href) return currentPath.endsWith(`/${lang}/`) || currentPath.endsWith(`/${lang}`);
  return currentPath.includes(`/${lang}/${href}`);
}

function isGroupCurrent(items: { href: string }[]) {
  return items.some((item) => isCurrent(item.href));
}
---

<!doctype html>
<html lang={lang === 'zh-cn' ? 'zh-Hans' : lang === 'en' ? 'en' : 'zh-Hant'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#171713" />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+SC:wght@400;600;700&family=Noto+Serif+TC:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>{title ?? `${t('siteTitle')} · ${t('siteTagline')}`}</title>
    <meta name="description" content={t('siteDesc')} />
    <link rel="alternate" hreflang="zh-Hant" href={sitePath('', 'zh-tw')} />
    <link rel="alternate" hreflang="zh-Hans" href={sitePath('', 'zh-cn')} />
    <link rel="alternate" hreflang="en" href={sitePath('', 'en')} />
    <link rel="alternate" hreflang="x-default" href={sitePath('', 'zh-tw')} />
  </head>
  <body class="museum-site flex min-h-screen flex-col">
    <header class="museum-header">
      <div class="museum-container museum-header__inner">
        <a href={pathFor('')} class="museum-brand" aria-label={`${t('siteTitle')} — ${t('home')}`}>
          <span class="museum-brand__copy">
            <span class="museum-brand__name">{t('siteTitle')}</span>
            <span class="museum-brand__tagline">{t('siteTagline')}</span>
          </span>
        </a>

        <div class="museum-tools">
          <div class="search-bar">
            <SearchBar client:load />
          </div>
          <div class="museum-language" aria-label="Language selector">
            {LANGS.map((item) => (
              <a href={sitePath(Astro.url.pathname.split('/').slice(3).join('/'), item.code)} aria-current={item.code === lang ? 'page' : undefined}>
                {item.short}
              </a>
            ))}
          </div>
          <details class="museum-mobile-menu">
            <summary aria-label="Open navigation menu"></summary>
            <div class="museum-mobile-menu__panel">
              <a href={pathFor('')} class="museum-mobile-menu__home" aria-current={isCurrent('') ? 'page' : undefined}>{t('home')}</a>
              {navGroups.map((group) => (
                <details open={isGroupCurrent(group.items)}>
                  <summary>{t(group.labelKey)}</summary>
                  <div>
                    {group.items.map((item) => (
                      <a href={pathFor(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{t(item.labelKey)}</a>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </details>
        </div>
      </div>
      <div class="museum-header__nav-row">
        <div class="museum-container">
          <nav class="museum-nav" aria-label="Primary navigation">
            <a href={pathFor('')} class="museum-nav__link" aria-current={isCurrent('') ? 'page' : undefined}>{t('home')}</a>
            {navGroups.map((group) => (
              <details class="museum-nav__group">
                <summary class:list={['museum-nav__summary', isGroupCurrent(group.items) && 'museum-nav__summary--current']}>
                  {t(group.labelKey)}
                </summary>
                <div class="museum-nav__dropdown">
                  {group.items.map((item) => (
                    <a href={pathFor(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{t(item.labelKey)}</a>
                  ))}
                </div>
              </details>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="museum-footer">
      <div class="museum-container museum-footer__inner">
        <div>
          <div class="museum-footer__title">{t('siteTitle')}</div>
          <p class="museum-footer__copy">{t('footerPeace')}</p>
        </div>
        <p class="museum-footer__copy">{t('footerSource')}</p>
        <div class="museum-footer__meta">
          <span>{lastUpdated ? `${t('footerUpdated')}：${lastUpdated}` : t('footerVersion')}</span>
          <span>{t('footerReport')} <a href="https://github.com/clairesun6767/1949-guningtou/issues/new?template=史料回報.yml">{t('footerReportLink')}</a></span>
          {lang !== 'zh-tw' && <span>{t('translationInProgress')}</span>}
        </div>
      </div>
    </footer>

    <script>
      const desktopNavGroups = document.querySelectorAll<HTMLDetailsElement>('.museum-nav__group');

      desktopNavGroups.forEach((group) => {
        group.addEventListener('toggle', () => {
          if (!group.open) return;
          desktopNavGroups.forEach((otherGroup) => {
            if (otherGroup !== group) otherGroup.removeAttribute('open');
          });
        });
      });
    </script>
  </body>
</html>
