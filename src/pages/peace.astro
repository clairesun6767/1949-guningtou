---
import MainLayout from '../layouts/MainLayout.astro';
const base = import.meta.env.BASE_URL;

const timeline = [
  { year: '1949', title: '古寧頭戰役', desc: '10月25-27日，戰役改變兩岸格局。金門成為台海防衛最前線。' },
  { year: '1950', title: '韓戰爆發', desc: '6月韓戰爆發，美國第七艦隊協防台灣海峽。金門戰略地位進一步提升。' },
  { year: '1956', title: '金門戰地政務', desc: '金門全面實施戰地政務，進入軍事管制時期。居民生活受到嚴格管制。' },
  { year: '1958', title: '八二三砲戰', desc: '8月23日，解放軍對金門實施大規模砲擊，持續44天。金門承受超過47萬發砲彈。' },
  { year: '1960s-70s', title: '單打雙不打', desc: '解放軍採取「單日砲擊、雙日停火」策略。金門居民適應戰地生活節奏。' },
  { year: '1992', title: '解除戰地政務', desc: '金門解除長達36年的戰地政務，回歸地方自治。觀光業開始發展。' },
  { year: '1995', title: '古寧頭戰史館', desc: '金門國家公園成立。古寧頭戰史館成為重要歷史教育與觀光據點。' },
  { year: '2001', title: '小三通實施', desc: '金門與廈門之間的小三通正式啟動，兩岸民間交流逐漸恢復。' },
  { year: '2010s', title: '地雷排除', desc: '金門持續進行地雷與未爆彈清除作業。許多昔日禁區重新開放。' },
  { year: '2020s', title: '戰地文化保存', desc: '金門軍事遺跡列入文化保存。安東二營區等據點轉型為文化觀光空間。' },
  { year: '今日', title: '和平地景', desc: '昔日戰場成為潮汐來回的沙灘。戰地遺跡與和平地景共存，見證歷史的轉變。' },
];
---

<MainLayout>
  <div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-serif font-bold mb-2">戰後至和平</h1>
    <p class="text-stone-500 mb-10">1949 → 今日 · 從戰場到和平地景的七十年旅程</p>

    <!-- Timeline -->
    <div class="relative border-l-2 border-green-200 ml-3 space-y-0">
      {timeline.map((item, i) => (
        <div class="pl-8 pb-8 relative">
          <div class="absolute left-[-7px] top-1 w-3.5 h-3.5 rounded-full bg-green-500 border-2 border-white shadow" />
          <div class="bg-white rounded-xl border border-stone-200 p-5">
            <span class="text-sm font-bold text-green-700">{item.year}</span>
            <h3 class="font-bold text-stone-800 mt-1">{item.title}</h3>
            <p class="text-sm text-stone-600 mt-1 leading-relaxed">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Sections -->
    <div class="mt-12 space-y-6">
      <div class="bg-white rounded-xl border border-stone-200 p-6">
        <h2 class="font-bold text-lg mb-3">🏚️ 聚落修復與文化保存</h2>
        <p class="text-sm text-stone-600 leading-relaxed">
          古寧頭北山、南山、林厝等聚落在戰火中受損嚴重。戰後經由政府與民間合作，
          逐步修復閩南傳統建築。金門國家公園成立後，更將聚落整體納入文化景觀保存範圍，
          使古寧頭成為台灣最具代表性的戰地文化景觀之一。
        </p>
      </div>

      <div class="bg-white rounded-xl border border-stone-200 p-6">
        <h2 class="font-bold text-lg mb-3">🕊️ 古寧頭和平紀念公園</h2>
        <p class="text-sm text-stone-600 leading-relaxed">
          位於林厝的古寧頭和平紀念公園，原為國軍砲陣地。園區內設有和平鐘、紀念碑與展覽空間，
          以「和平」為主題重新詮釋戰地歷史，成為金門重要的歷史教育場域。
        </p>
      </div>

      <div class="bg-white rounded-xl border border-stone-200 p-6">
        <h2 class="font-bold text-lg mb-3">🏕️ 安東二營區活化</h2>
        <p class="text-sm text-stone-600 leading-relaxed">
          安東二營區為古寧頭戰役期間的國軍重要據點。近年由民間進駐活化，
          轉型為文化創意與觀光空間，成為金門戰地遺跡再生的典範案例。
        </p>
      </div>

      <div class="bg-white rounded-xl border border-stone-200 p-6">
        <h2 class="font-bold text-lg mb-3">🌏 從對峙到交流</h2>
        <p class="text-sm text-stone-600 leading-relaxed">
          從 1949 年的激烈戰鬥，到 2001 年小三通的啟動，金門的角色從「反共最前線」
          轉變為「兩岸交流的橋樑」。金門的歷史，正是兩岸關係從軍事衝突走向和平交流的縮影。
        </p>
      </div>
    </div>

    <div class="mt-10 text-center">
      <blockquote class="font-serif text-xl text-stone-500 italic">
        「歷史無法改變，但和平可以選擇。」
      </blockquote>
    </div>
  </div>
</MainLayout>
