---
import MainLayout from '../layouts/MainLayout.astro';
const base = import.meta.env.BASE_URL;
---

<MainLayout>
  <div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-serif font-bold mb-2">戰役影響</h1>
    <p class="text-stone-500 mb-10">一場三天的戰役，改變了兩岸七十年的命運</p>

    <!-- Level 1: 兩岸 -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white text-sm font-bold">兩</span>
        <h2 class="text-xl font-serif font-bold">對兩岸的影響</h2>
      </div>
      <div class="space-y-4">
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">政治</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            古寧頭戰役是國共內戰中，國軍首次成功阻止解放軍渡海作戰的關鍵戰役。
            此役確立了台海分治的格局——中華民國政府於同年12月遷台，兩岸從此走上不同的政治發展道路。
            古寧頭被台灣方面定位為「台海第一戰」，象徵保衛台澎金馬的決心。
          </p>
        </div>
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">軍事</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            戰役暴露了解放軍渡海作戰的致命弱點：缺乏海空支援、船隻不足、潮汐掌握不佳。
            此後解放軍暫緩對台渡海計畫，轉而強化海空軍建設。對國軍而言，古寧頭成為防衛作戰的典範教材。
          </p>
        </div>
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">外交</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            1950年6月韓戰爆發後，美國第七艦隊進駐台灣海峽。古寧頭象徵的「台海防衛能力」，
            成為美國遠東戰略的重要考量因素，也影響了接下來數十年的美中台三角關係。
          </p>
        </div>
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">冷戰格局</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            古寧頭戰役發生在冷戰初始階段。這場區域性衝突被納入全球冷戰框架，
            金門從此成為「自由世界 vs 共產陣營」在亞洲的最前線象徵。
          </p>
        </div>
      </div>
    </section>

    <!-- Level 2: 金門 -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-8 rounded-full bg-amber-600 flex items-center justify-center text-white text-sm font-bold">金</span>
        <h2 class="text-xl font-serif font-bold">對金門的影響</h2>
      </div>
      <div class="space-y-4">
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">軍管時期</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            戰後金門進入長達36年的戰地政務時期（1956-1992）。居民生活受軍事管制，
            包含宵禁、燈火管制、出入境限制、建築高度限制等。金門成為一座「戰地島嶼」。
          </p>
        </div>
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">經濟轉變</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            大量駐軍帶來消費需求，催生了金門特有的「軍中經濟」。高粱酒、貢糖等產業因應軍隊需求而發展。
            1992年解嚴後，駐軍大幅縮減，金門經濟轉向觀光與文化產業。
          </p>
        </div>
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">教育與文化</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            戰地政務時期的教育強調愛國意識。金門中小學課程融入戰地元素，
            學生參與民防訓練。數十年後，戰地記憶已成為金門人集體身分認同的一部分。
          </p>
        </div>
      </div>
    </section>

    <!-- Level 3: 聚落 -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-8 rounded-full bg-green-600 flex items-center justify-center text-white text-sm font-bold">村</span>
        <h2 class="text-xl font-serif font-bold">對古寧頭聚落的影響</h2>
      </div>
      <div class="space-y-4">
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">人口變遷</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            戰後部分居民遷離戰區，北山、南山、林厝等村落人口銳減。
            年輕一代外移就學就業，聚落面臨老化與空洞化挑戰。
          </p>
        </div>
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">建築與土地</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            戰火損壞大量傳統閩南建築。戰後重建中，部分土地被劃為軍事用地，
            限制了聚落的自然擴張。1995年國家公園成立後，聚落建築納入文化保存體系。
          </p>
        </div>
        <div class="bg-white rounded-xl border border-stone-200 p-5">
          <h3 class="font-bold text-stone-700">宗族與文化</h3>
          <p class="text-sm text-stone-600 mt-1 leading-relaxed">
            古寧頭為單姓聚落（李姓為主），宗族組織緊密。戰火雖摧毀了部分宗祠，
            但戰後族人積極重建，宗族文化得以延續。今日的古寧頭，傳統宗族與戰地記憶交織共生。
          </p>
        </div>
      </div>
    </section>

    <div class="text-center mt-8">
      <a href={`${base}peace`} class="text-amber-600 hover:text-amber-800 no-underline font-medium">
        繼續閱讀：戰後至和平 →
      </a>
    </div>
  </div>
</MainLayout>
