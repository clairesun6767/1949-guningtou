---
import MainLayout from '../../layouts/MainLayout.astro';
import EvidenceCard from '../../components/museum/EvidenceCard.astro';
import SectionHeading from '../../components/museum/SectionHeading.astro';
import { sources } from '../../data/loader';

const levelDist: Record<string, number> = {};
sources.forEach((source) => {
  const level = String(source.source_level ?? '?');
  levelDist[level] = (levelDist[level] ?? 0) + 1;
});

const LEVELS = [
  { id: '1', label: '官方 / 一手來源' },
  { id: '2', label: '學術研究' },
  { id: '3', label: '輔助來源' },
  { id: '4', label: '參考來源' },
];

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---

<MainLayout lang={Astro.params.lang}>
  <div class="museum-page">
    <div class="museum-container">
      <SectionHeading level={1} index="01" eyebrow="SOURCES & PROVENANCE" title="史料與來源" description={`${sources.length} 筆文獻來源 · 所有史料可追溯 · 依來源等級分級。資料庫展示的是來源狀態，不是替讀者決定唯一答案。`} />

      <section class="museum-source-levels" aria-label="來源等級分布">
        {LEVELS.map((level) => (
          <div class="museum-source-level">
            <div class="museum-source-level__count">{levelDist[level.id] ?? 0}</div>
            <div class="museum-meta">LEVEL {level.id}</div>
            <div class="museum-source-level__label">{level.label}</div>
          </div>
        ))}
      </section>

      <div class="museum-source-list">
        {sources.map((source) => <EvidenceCard source={source} />)}
      </div>
    </div>
  </div>
</MainLayout>
