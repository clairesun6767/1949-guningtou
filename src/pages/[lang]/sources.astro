---
import MainLayout from '../../layouts/MainLayout.astro';
import EvidenceCard from '../../components/museum/EvidenceCard.astro';
import SectionHeading from '../../components/museum/SectionHeading.astro';
import { sources } from '../../data/loader';

const lang = Astro.params.lang ?? 'zh-tw';
const isEnglish = lang === 'en';

const levelDist: Record<string, number> = {};
sources.forEach((source) => {
  const level = String(source.source_level ?? '?');
  levelDist[level] = (levelDist[level] ?? 0) + 1;
});

const LEVELS = [
  { id: '1', label: '官方 / 一手來源', labelEn: 'Official / primary sources' },
  { id: '2', label: '學術研究', labelEn: 'Academic research' },
  { id: '3', label: '輔助來源', labelEn: 'Supporting sources' },
  { id: '4', label: '參考來源', labelEn: 'Reference sources' },
];

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---

<MainLayout lang={lang}>
  <div class="museum-page">
    <div class="museum-container">
      <SectionHeading level={1} index="01" eyebrow="SOURCES & PROVENANCE" title={isEnglish ? 'Sources and provenance' : '史料與來源'} description={isEnglish ? `${sources.length} source records · traceable provenance · grouped by source level. The database shows the status of sources; it does not decide a single answer for the reader.` : `${sources.length} 筆文獻來源 · 所有史料可追溯 · 依來源等級分級。資料庫展示的是來源狀態，不是替讀者決定唯一答案。`} />

      <section class="museum-source-levels" aria-label={isEnglish ? 'Source-level distribution' : '來源等級分布'}>
        {LEVELS.map((level) => (
          <div class="museum-source-level">
            <div class="museum-source-level__count">{levelDist[level.id] ?? 0}</div>
            <div class="museum-meta">LEVEL {level.id}</div>
            <div class="museum-source-level__label">{isEnglish ? level.labelEn : level.label}</div>
          </div>
        ))}
      </section>

      <div class="museum-source-list">
        {sources.map((source) => <EvidenceCard source={source} lang={lang} />)}
      </div>
    </div>
  </div>
</MainLayout>
