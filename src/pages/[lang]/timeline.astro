---
// /timeline — 互動時間軸頁面
import MainLayout from '../../layouts/MainLayout.astro';
import BattleTimeline from '../../components/timeline/BattleTimeline';
import SectionHeading from '../../components/museum/SectionHeading.astro';
import { timeline } from '../../data/loader';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---




<MainLayout lang={Astro.params.lang}>
  <div class="museum-page">
    <div class="museum-reading">
      <SectionHeading level={1} index="01" eyebrow="TIME RAIL" title="戰役時間軸" description={`1949 年 10 月 24—27 日 · 四日戰役逐時記錄 · ${timeline.length} 條時間點。選擇日期後展開節點，查看部隊、人物與證據狀態。`} />
      <BattleTimeline client:load entries={timeline} />
    </div>
  </div>
</MainLayout>
