---
import MainLayout from '../../layouts/MainLayout.astro';
import { sitePath } from '../../data/paths';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}

const destination = sitePath('context', Astro.params.lang);
---

<MainLayout lang={Astro.params.lang}>
  <meta http-equiv="refresh" content={`0;url=${destination}`} />
  <div class="museum-page">
    <div class="museum-reading museum-centered">
      <div class="museum-kicker">REDIRECT</div>
      <h1 class="museum-title">本頁內容已合併至「戰前國際情勢」</h1>
      <a class="museum-button" href={destination}>前往戰前國際情勢 →</a>
    </div>
  </div>
</MainLayout>
