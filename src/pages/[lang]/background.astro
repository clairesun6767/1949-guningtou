---
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---



<meta http-equiv="refresh" content="{`0;url=${base}context/`}" />
<script>location.href='{`${base}context/`}'</script>
<p>合併至「認識戰役」。<a href="{`${base}context/`}">點此前往</a></p>
