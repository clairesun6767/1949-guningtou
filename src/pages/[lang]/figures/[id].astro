---
import MainLayout from '../../../layouts/MainLayout.astro';
import MetadataRow from '../../../components/museum/MetadataRow.astro';
import SourceCitation from '../../../components/museum/SourceCitation.astro';
import { sitePath } from '../../../data/paths';
import { persons } from '../../../data/loader';
import { displayRank, displayUnit, displayVerificationStatus } from '../../../i18n/labels';
import MediaCard from '../../../components/museum/MediaCard.astro';
import { getPersonMedia } from '../../../data/mediaCatalog';
import { getPersonCopy } from '../../../i18n/historicalContent';

export function getStaticPaths() {
  const langs = ['zh-tw', 'zh-cn', 'en'];
  const paths = [];
  for (const lang of langs) {
    for (const item of persons) paths.push({ params: { lang, id: item.person_id } });
  }
  return paths;
}

const { id, lang } = Astro.params;
const isEnglish = lang === 'en';
const person = persons.find((item) => item.person_id === id);
const personMedia = person ? getPersonMedia(person.person_id) : [];
const personCopy = person ? getPersonCopy(person, lang) : null;
const noPortraitLabel = isEnglish
  ? 'No legally publishable portrait is currently available.'
  : lang === 'zh-cn'
    ? '目前没有可合法公开的肖像。'
    : '目前沒有可合法公開的肖像。';
---

<MainLayout lang={lang}>
  {person ? (
    <div class="museum-page">
      <div class="museum-reading">
        <a href={sitePath('figures', lang)} class="museum-link">{isEnglish ? '← Back to people records' : '← 回到人物檔案'}</a>
        <div class="museum-kicker museum-space-before">PERSON RECORD · {person.person_id}</div>
        <h1 class="museum-title">{personCopy?.name}</h1>
        {person.name_en && <p class="museum-deck">{person.name_en}</p>}

        <div class="museum-person-detail__status">
          {person.evidence_level && <span class={`evidence-badge evidence-${person.evidence_level}`}>{isEnglish ? 'Evidence' : '證據'} {person.evidence_level}</span>}
          {person.verification_status && <SourceCitation text={displayVerificationStatus(person.verification_status, lang) ?? person.verification_status} />}
        </div>

        <section class="museum-reading__section museum-person-detail__media">
          <div class="museum-kicker">{isEnglish ? 'VISUAL RECORDS' : lang === 'zh-cn' ? '影像记录' : '影像記錄'}</div>
          <div class="museum-grid museum-grid--2">
            {personMedia.length > 0
              ? personMedia.map((asset) => <MediaCard asset={asset} lang={lang} />)
              : <div class="museum-card museum-person-placeholder">
                  <img src={sitePath('media/guningtou/portrait-placeholder.svg')} alt={noPortraitLabel} loading="lazy" decoding="async" />
                  <p class="museum-citation">{noPortraitLabel}</p>
                </div>}
          </div>
        </section>

        <section class="museum-paper museum-reading__section">
          <div class="museum-kicker">{isEnglish ? 'BIOGRAPHICAL NOTE' : lang === 'zh-cn' ? '人物简介' : '人物簡介'}</div>
          <p class="museum-prose">{personCopy?.bio}</p>
        </section>

        <div class="museum-meta-grid museum-person-detail__meta">
          <MetadataRow label={isEnglish ? 'Affiliation / category' : lang === 'zh-cn' ? '阵营 / 类别' : '陣營 / 類別'} value={personCopy?.category} />
          <MetadataRow label={isEnglish ? 'Rank' : lang === 'zh-cn' ? '军阶' : '軍階'} value={displayRank(person.rank_at_event, lang)} />
          <MetadataRow label={isEnglish ? 'Unit' : lang === 'zh-cn' ? '单位' : '單位'} value={displayUnit(person.unit, lang)} />
          <MetadataRow label={isEnglish ? 'Life dates' : lang === 'zh-cn' ? '生卒' : '生卒'} value={`${person.birth_date ?? '?'} – ${person.death_date ?? '?'}`} />
        </div>

        {person.role_in_battle && (
          <section class="museum-reading__section">
            <div class="museum-kicker">ROLE IN BATTLE</div>
            <h2>{isEnglish ? 'Role in the battle' : lang === 'zh-cn' ? '战役角色' : '戰役角色'}</h2>
            <p class="museum-prose">{personCopy?.role}</p>
          </section>
        )}

        {person.battle_actions && (
          <section class="museum-reading__section">
            <div class="museum-kicker">ACTIONS & ACCOUNTS</div>
            <h2>{isEnglish ? 'Actions and accounts' : lang === 'zh-cn' ? '相关行动' : '相關行動'}</h2>
            <p class="museum-prose">{personCopy?.actions}</p>
          </section>
        )}

        {person.related_sources && person.related_sources.length > 0 && (
          <section class="museum-reading__section">
            <div class="museum-kicker">SOURCES</div>
            <h2>{isEnglish ? 'Sources' : '來源'}</h2>
            <p class="museum-citation">{person.related_sources.join(' · ')}</p>
          </section>
        )}
      </div>
    </div>
  ) : (
    <div class="museum-page">
      <div class="museum-reading museum-centered">
        <div class="museum-kicker">RECORD NOT FOUND</div>
        <h1 class="museum-title">{isEnglish ? 'Person not found' : '人物不存在'}</h1>
        <a class="museum-button" href={sitePath('figures', lang)}>{isEnglish ? 'Back to people records' : '回到人物檔案'}</a>
      </div>
    </div>
  )}
</MainLayout>
