---
import MainLayout from '../../layouts/MainLayout.astro';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---



<MainLayout>
  <meta http-equiv="refresh" content={`0;url=${base}aftermath/`} />
  <div class="max-w-3xl mx-auto px-4 py-16 text-center">
    <p class="text-stone-500">頁面已合併至「戰後影響」。正在重新導向...</p>
    <a href={`${base}aftermath/`} class="text-amber-600">點此前往</a>
  </div>
</MainLayout>
