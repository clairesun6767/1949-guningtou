---
import MainLayout from '../../layouts/MainLayout.astro';
import { sitePath } from '../../data/paths';

const lang = Astro.params.lang ?? 'zh-tw';
const isEnglish = lang === 'en';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---



<MainLayout lang={lang}>
  <meta http-equiv="refresh" content={'0;url=' + sitePath('postwar', lang)} />
  <div class="museum-page">
    <div class="museum-reading museum-centered">
      <div class="museum-kicker">REFLECTION</div>
      <h1 class="museum-title">{isEnglish ? 'This page has moved to “Post-War Kinmen”' : lang === 'zh-cn' ? '页面已移至「战后金门」' : '頁面已移至「戰後金門」'}</h1>
      <p class="museum-deck museum-deck--centered museum-space-after">{isEnglish ? 'Redirecting now, or open the post-war history page directly.' : lang === 'zh-cn' ? '正在重新导向，或直接进入战后金门页面。' : '正在重新導向，或直接進入戰後金門頁面。'}</p>
      <a class="museum-button" href={sitePath('postwar', lang)}>{isEnglish ? 'Go to Post-War Kinmen →' : lang === 'zh-cn' ? '前往战后金门 →' : '前往戰後金門 →'}</a>
    </div>
  </div>
</MainLayout>
