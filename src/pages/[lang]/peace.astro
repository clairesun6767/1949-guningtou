---
import MainLayout from '../../layouts/MainLayout.astro';
import { sitePath } from '../../data/paths';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---



<MainLayout lang={Astro.params.lang}>
  <meta http-equiv="refresh" content={`0;url=${sitePath('aftermath', Astro.params.lang)}`} />
  <div class="museum-page">
    <div class="museum-reading museum-centered">
      <div class="museum-kicker">REFLECTION</div>
      <h1 class="museum-title">頁面已合併至「戰後影響」</h1>
      <p class="museum-deck museum-deck--centered museum-space-after">正在重新導向，或直接進入戰後影響頁面。</p>
      <a class="museum-button" href={sitePath('aftermath', Astro.params.lang)}>前往戰後影響 →</a>
    </div>
  </div>
</MainLayout>
