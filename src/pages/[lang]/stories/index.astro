---
import MainLayout from '../../../layouts/MainLayout.astro';
import SectionHeading from '../../../components/museum/SectionHeading.astro';
import { sitePath } from '../../../data/paths';
import { storyArcs, scenes, narrativeBeats } from '../../../data/loader';

const lang = Astro.params.lang;

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---

<MainLayout lang={lang}>
  <div class="museum-page">
    <div class="museum-container">
      <SectionHeading level={1} index="01" eyebrow="NARRATIVE ARCS" title="戰役故事" description={`${storyArcs.length} 條故事弧線 · ${scenes.length} 個場景 · ${narrativeBeats.length} 個敘事節拍。從結構化資料回到一段可被閱讀的歷史經驗。`} />
      <div class="museum-grid museum-grid--2">
        {storyArcs.map((arc) => (
          <a href={sitePath(`stories/${arc.story_arc_id}`, lang)} class="museum-card museum-card-link museum-story-card">
            <div class="museum-story-card__head"><span class="museum-label">{arc.story_arc_id}</span><span class="museum-citation">{arc.content_type || 'NARRATIVE'}</span></div>
            <h2>{arc.title}</h2>
            {arc.theme && <p class="museum-story-card__theme">{arc.theme}</p>}
            {arc.historical_scope && <p>{arc.historical_scope}</p>}
            <span class="museum-link">進入故事 →</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
