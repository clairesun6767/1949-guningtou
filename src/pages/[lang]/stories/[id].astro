---
import MainLayout from '../../../layouts/MainLayout.astro';
import { storyArcs, scenes, narrativeBeats } from '../../../data/loader';

export function getStaticPaths() {
  const langs = ['zh-tw', 'zh-cn', 'en'];
  const paths = [];
  for (const lang of langs) {
    for (const arc of storyArcs) {
      paths.push({ params: { lang, id: arc.story_arc_id } });
    }
  }
  return paths;
}

const { id } = Astro.params;
const arc = storyArcs.find((a) => a.story_arc_id === id);
const arcScenes = scenes
  .filter((s) => s.story_arc_id === id)
  .sort((a, b) => (a.sequence_number ?? 0) - (b.sequence_number ?? 0));
---

<MainLayout>
  {arc ? (
    <div class="max-w-3xl mx-auto px-4 py-16">
      <a href="./stories" class="text-sm text-stone-500 hover:text-stone-700 no-underline">&larr; 回到故事列表</a>
      <h1 class="text-3xl font-serif font-bold mt-4 mb-2">{arc.title}</h1>
      {arc.theme && <p class="text-stone-500 mb-8">{arc.theme}</p>}

      {arc.start_state && (
        <div class="bg-white rounded-xl border border-stone-200 p-6 mb-6">
          <h2 class="font-semibold text-sm text-stone-500 uppercase tracking-wide mb-2">背景</h2>
          <p class="text-stone-700">{arc.start_state}</p>
        </div>
      )}

      <div class="space-y-4">
        <h2 class="font-semibold text-lg text-stone-700">場景（{arcScenes.length}）</h2>
        {arcScenes.map((scene) => (
          <div class="bg-white rounded-lg border border-stone-200 p-4">
            <h3 class="font-medium text-stone-800">{scene.sequence_number}. {scene.scene_title}</h3>
            <p class="text-xs text-stone-400">{scene.scene_type} · {scene.start_datetime}</p>
            {scene.scene_summary && (
              <p class="text-sm text-stone-600 mt-2">{scene.scene_summary}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  ) : (
    <div class="max-w-3xl mx-auto px-4 py-16 text-center">
      <h1 class="text-2xl font-bold text-stone-700">故事不存在</h1>
      <a href="./stories" class="text-amber-600">回到故事列表</a>
    </div>
  )}
</MainLayout>
