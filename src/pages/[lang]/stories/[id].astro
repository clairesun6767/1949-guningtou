---
import MainLayout from '../../../layouts/MainLayout.astro';
import { sitePath } from '../../../data/paths';
import { storyArcs, scenes } from '../../../data/loader';

export function getStaticPaths() {
  const paths = [];
  for (const lang of ['zh-tw', 'zh-cn', 'en']) {
    for (const arc of storyArcs) paths.push({ params: { lang, id: arc.story_arc_id } });
  }
  return paths;
}

const { id, lang } = Astro.params;
const arc = storyArcs.find((item) => item.story_arc_id === id);
const arcScenes = scenes.filter((scene) => scene.story_arc_id === id).sort((a, b) => (a.sequence_number ?? 0) - (b.sequence_number ?? 0));
---

<MainLayout lang={lang}>
  {arc ? (
    <div class="museum-page">
      <div class="museum-reading">
        <a href={sitePath('stories', lang)} class="museum-link">← 回到戰役故事</a>
        <div class="museum-kicker museum-space-before">NARRATIVE ARC · {arc.story_arc_id}</div>
        <h1 class="museum-title">{arc.title}</h1>
        {arc.theme && <p class="museum-deck">{arc.theme}</p>}

        {arc.start_state && (
          <section class="museum-paper museum-reading__section">
            <div class="museum-kicker">STARTING STATE</div>
            <p class="museum-prose">{arc.start_state}</p>
          </section>
        )}

        <section class="museum-reading__section">
          <div class="museum-kicker">SCENES · {arcScenes.length}</div>
          <div class="museum-story-scenes">
            {arcScenes.map((scene) => (
              <article class="museum-card museum-story-scene">
                <div class="museum-meta">{String(scene.sequence_number ?? '').padStart(2, '0')} · {scene.scene_type || 'SCENE'} · {scene.start_datetime || 'TIME UNKNOWN'}</div>
                <h2>{scene.scene_title}</h2>
                {scene.scene_summary && <p class="museum-prose">{scene.scene_summary}</p>}
                {scene.evidence_level && <span class={`evidence-badge evidence-${scene.evidence_level}`}>證據 {scene.evidence_level}</span>}
              </article>
            ))}
          </div>
        </section>
      </div>
    </div>
  ) : (
    <div class="museum-page"><div class="museum-reading museum-centered"><div class="museum-kicker">RECORD NOT FOUND</div><h1 class="museum-title">故事不存在</h1><a class="museum-button" href={sitePath('stories', lang)}>回到戰役故事</a></div></div>
  )}
</MainLayout>
