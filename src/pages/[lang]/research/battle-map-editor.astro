---
import HistoricalBattleMapRegistrationEditor from '../../../components/dev/HistoricalBattleMapRegistrationEditor';
import '../../../styles/global.css';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---

<!doctype html>
<html lang={Astro.params.lang === 'en' ? 'en' : 'zh-Hant'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>研究編修工具 · Historical Battle Map Registration</title>
  </head>
  <body>
    <HistoricalBattleMapRegistrationEditor client:only="react" base={import.meta.env.BASE_URL} />
  </body>
</html>
