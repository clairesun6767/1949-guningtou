const transformationCards = [
  {
    mark: 'P',
    title: { 'zh-tw': '國家公園保存', 'zh-cn': '国家公园保存', en: 'National Park conservation' },
    body: { 'zh-tw': '把戰地遺址、傳統聚落與自然環境放進同一套保存與解說框架，讓軍事地景不只被觀看，也能被研究、維護與理解。', 'zh-cn': '把战地遗址、传统聚落与自然环境放进同一套保存与解说框架，让军事地景不只被观看，也能被研究、维护与理解。', en: 'Battlefield sites, traditional settlements, and natural environments are interpreted within one conservation framework so military landscapes can be studied, maintained, and understood rather than merely viewed.' },
    source: 'https://www.kmnp.gov.tw/ch/planlist/conservation-achievement-reports/18',
  },
  {
    mark: 'R',
    title: { 'zh-tw': '營區與戰史館再利用', 'zh-cn': '营区与战史馆再利用', en: 'Adaptive reuse of camps and the museum' },
    body: { 'zh-tw': '戰史館、營區、碉堡與海岸節點可透過展演、步行路線與公共教育重新連線。再利用的前提是保留史蹟脈絡，並清楚區分已證實資料與待查節點。', 'zh-cn': '战史馆、营区、碉堡与海岸节点可通过展演、步行路线与公共教育重新连接。再利用的前提是保留史迹脉络，并清楚区分已证实资料与待查节点。', en: 'Museums, camps, bunkers, and coastal nodes can be reconnected through interpretation, walking routes, and public education. Adaptive reuse should preserve historical context and distinguish supported evidence from nodes still under review.' },
    source: 'https://www.taiwan.nps.gov.tw/home/zh-tw/news/30051.html',
  },
  {
    mark: 'C',
    title: { 'zh-tw': '縣府、國家公園與社區協作', 'zh-cn': '县府、国家公园与社区协作', en: 'County, National Park, and community collaboration' },
    body: { 'zh-tw': '金門縣政府、金門國家公園與地方社區的建設及活動，逐步把戰場、閩南文化、生態、慢活與和平紀念串在一起。官方規劃可作為未來工作帶的公共討論起點。', 'zh-cn': '金门县政府、金门国家公园与地方社区的建设及活动，逐步把战场、闽南文化、生态、慢活与和平纪念串在一起。官方规划可作为未来工作带的公共讨论起点。', en: 'Projects and programs by Kinmen County, Kinmen National Park, and local communities increasingly connect battlefield heritage with Minnan culture, ecology, slow travel, and peace commemoration. Official plans provide a starting point for public discussion of future heritage bands.' },
    source: 'https://www.kinmen.gov.tw/News_Content2.aspx?n=98E3CA7358C89100&s=C0B47D98C645525B&sms=BF7D6D478B935644',
  },
  {
    mark: 'T',
    title: { 'zh-tw': '觀光路線與公共活動', 'zh-cn': '观光路线与公共活动', en: 'Tourism routes and public programs' },
    body: { 'zh-tw': '古寧頭戰場線、文化資產導覽、戰役週年紀念與環境教育，讓人們能以步行、展覽、祭典或地方故事接近同一段海岸。活動不應取代史料，而應成為回到史料的入口。', 'zh-cn': '古宁头战场线、文化资产导览、战役周年纪念与环境教育，让人们能以步行、展览、祭典或地方故事接近同一段海岸。活动不应取代史料，而应成为回到史料的入口。', en: 'The Guningtou battlefield route, heritage interpretation, anniversary commemorations, and environmental education bring people to the same coast through walking, exhibitions, ritual, and local stories. Programs should not replace sources; they should lead people back to them.' },
    source: 'https://www.kinmen.travel/zh-tw/discover/tour/171',
  },
];

const memoryCards = [
  {
    mark: 'R',
    title: { 'zh-tw': '國共軍陣亡將士的共同祭祀', 'zh-cn': '国共军阵亡将士的共同祭祀', en: 'Ritual for the dead of both armies' },
    body: { 'zh-tw': '官方報導記錄李光前將軍廟／安東一帶對兩岸陣亡者的祭祀脈絡。頁面保留不同群體的稱呼與記憶，不替地方信仰或政治立場作單一裁決。', 'zh-cn': '官方报道记录李光前将军庙／安东一带对两岸阵亡者的祭祀脉络。本页保留不同群体的称呼与记忆，不替地方信仰或政治立场作单一裁决。', en: 'Official reports document a ritual context around General Li Guangqian Shrine and Andong that remembers the dead on both sides. This page preserves different names and memories without imposing a single theological or political judgment.' },
    source: 'https://www.kinmen.gov.tw/News_Content2.aspx?n=98E3CA7358C89100&s=3446152EEAD4A60F&sms=BF7D6D478B935644',
  },
  {
    mark: 'M',
    title: { 'zh-tw': '萬善祠與古寧頭戰役紀念', 'zh-cn': '万善祠与古宁头战役纪念', en: 'Wan Shan Shrine and Guningtou commemorations' },
    body: { 'zh-tw': '金門縣府、金門防衛指揮部、國家公園與地方居民共同參與春、秋祭典等官方紀念活動。紀念同時指向戰亡者、地方安魂與對和平的期待。', 'zh-cn': '金门县府、金门防卫指挥部、国家公园与地方居民共同参与春、秋祭典等官方纪念活动。纪念同时指向战亡者、地方安魂与对和平的期待。', en: 'Kinmen County, the Kinmen Defense Command, the National Park, and local residents take part in official spring and autumn commemorations. These rituals remember the war dead, local spirits, and hopes for peace at the same time.' },
    source: 'https://kccad.kinmen.gov.tw/News_Content.aspx?n=1401293451C14B5D&s=8D213EF24657CE09&sms=41E369FD1B4C8BC0',
  },
  {
    mark: 'L',
    title: { 'zh-tw': '地方路祭與民間記憶', 'zh-cn': '地方路祭与民间记忆', en: 'Local processions and lived memory' },
    body: { 'zh-tw': '地方祭祀與路祭把戰場、聚落、廟宇和家族記憶連在一起。這些活動是活的文化實踐，應與檔案、口述史及現地解說並讀，而不是被簡化成單一觀光符號。', 'zh-cn': '地方祭祀与路祭把战场、聚落、庙宇和家族记忆连在一起。这些活动是活的文化实践，应与档案、口述史及现场解说并读，而不是被简化成单一观光符号。', en: 'Local rituals and processions connect battlefields, settlements, temples, and family memory. They are living cultural practices that should be read alongside archives, oral history, and site interpretation rather than reduced to a single tourism symbol.' },
    source: 'https://www.kinmen.gov.tw/News_Content2.aspx?Create=1&n=98E3CA7358C89100&s=F4337467D376352F&sms=BF7D6D478B935644',
  },
  {
    mark: 'P',
    title: { 'zh-tw': '從對峙到交流的和平語境', 'zh-cn': '从对峙到交流的和平语境', en: 'A peace context moving beyond confrontation' },
    body: { 'zh-tw': '官方資料記錄後代尋訪、共同祭祀與兩岸交流活動。對金門而言，交流不是抹去衝突，而是讓記憶、責任與未來和平能在同一個公共空間被討論。', 'zh-cn': '官方资料记录后代寻访、共同祭祀与两岸交流活动。对金门而言，交流不是抹去冲突，而是让记忆、责任与未来和平能在同一个公共空间被讨论。', en: 'Official material records descendant visits, shared rituals, and cross-Strait exchange. For Kinmen, exchange does not erase conflict; it creates a public space in which memory, responsibility, and a peaceful future can be discussed together.' },
    source: 'https://www.kinmen.gov.tw/News_Content2.aspx?n=98E3CA7358C89100&s=3446152EEAD4A60F&sms=BF7D6D478B935644',
  },
];

const futureItems = [
  { mark: '01', title: { 'zh-tw': '保存真實地景，避免過度景觀化', 'zh-cn': '保存真实地景，避免过度景观化', en: 'Preserve authentic landscapes without over-commercialization' }, body: { 'zh-tw': '優先維護遺址、聚落、生態與居民使用脈絡，讓觀光服務服從於保存與理解。', 'zh-cn': '优先维护遗址、聚落、生态与居民使用脉络，让观光服务服从于保存与理解。', en: 'Prioritize sites, settlements, ecology, and lived context so tourism serves conservation and understanding.' } },
  { mark: '02', title: { 'zh-tw': '先完成節點清冊，再進入正式地圖', 'zh-cn': '先完成节点清册，再进入正式地图', en: 'Complete the node register before formal mapping' }, body: { 'zh-tw': 'W011、W012、W013、W016、W027 與北山相關名稱，應補上官方來源、名稱對照、位置證據與人工審核紀錄。', 'zh-cn': 'W011、W012、W013、W016、W027 与北山相关名称，应补上官方来源、名称对照、位置证据与人工审核记录。', en: 'W011, W012, W013, W016, W027, and Beishan names need official sources, name matching, location evidence, and human-review records before formal mapping.' } },
  { mark: '03', title: { 'zh-tw': '把營區、海岸、聚落與生態串成可步行路徑', 'zh-cn': '把营区、海岸、聚落与生态串成可步行路径', en: 'Connect camps, coast, settlements, and ecology as walkable routes' }, body: { 'zh-tw': '以可理解、可休息、可回到史料的路徑設計，讓活化不只是在據點放置新設施，而是建立地景之間的關係。', 'zh-cn': '以可理解、可休息、可回到史料的路径设计，让活化不只是在据点放置新设施，而是建立地景之间的关系。', en: 'Design routes that are legible, accessible, and source-linked. Activation should build relationships between landscapes rather than simply add new facilities at isolated sites.' } },
  { mark: '04', title: { 'zh-tw': '讓祭祀與交流成為和平教育的一部分', 'zh-cn': '让祭祀与交流成为和平教育的一部分', en: 'Make ritual and exchange part of peace education' }, body: { 'zh-tw': '以多元觀點、可追溯史料與地方參與，讓陣亡者記憶、家族故事與兩岸交流能被尊重地共同保存。', 'zh-cn': '以多元观点、可追溯史料与地方参与，让阵亡者记忆、家族故事与两岸交流能被尊重地共同保存。', en: 'Use multiple perspectives, traceable sources, and local participation to preserve memories of the dead, family stories, and cross-Strait exchange with care.' } },
];

const sourceLinks = [
  { label: { 'zh-tw': '金門國家公園：成立沿革', 'zh-cn': '金门国家公园：成立沿革', en: 'Kinmen National Park: institutional history' }, href: 'https://www.kmnp.gov.tw/ch/titlelist/office-introduction/492' },
  { label: { 'zh-tw': '金門國家公園：保育成果與戰地景觀', 'zh-cn': '金门国家公园：保育成果与战地景观', en: 'Kinmen National Park: conservation and battlefield landscape' }, href: 'https://www.kmnp.gov.tw/ch/planlist/conservation-achievement-reports/18' },
  { label: { 'zh-tw': '金門觀光：古寧頭戰史館', 'zh-cn': '金门观光：古宁头战史馆', en: 'Kinmen Tourism: Guningtou War Museum' }, href: 'https://kinmen.travel/zh-tw/travel/attraction/533' },
  { label: { 'zh-tw': '金門縣政府：國家公園與地方建設', 'zh-cn': '金门县政府：国家公园与地方建设', en: 'Kinmen County Government: National Park and local development' }, href: 'https://www.kinmen.gov.tw/News_Content2.aspx?n=98E3CA7358C89100&s=34C6C4E8F4CFFC5B&sms=BF7D6D478B935644' },
  { label: { 'zh-tw': '金門縣政府：古寧頭跨域亮點規劃', 'zh-cn': '金门县政府：古宁头跨域亮点规划', en: 'Kinmen County Government: Guningtou cross-sector plan' }, href: 'https://www.kinmen.gov.tw/News_Content2.aspx?n=98E3CA7358C89100&s=C0B47D98C645525B&sms=BF7D6D478B935644' },
  { label: { 'zh-tw': '金門縣政府：安東一帶祭祀與兩岸記憶', 'zh-cn': '金门县政府：安东一带祭祀与两岸记忆', en: 'Kinmen County Government: Andong ritual and cross-Strait memory' }, href: 'https://www.kinmen.gov.tw/News_Content2.aspx?n=98E3CA7358C89100&s=3446152EEAD4A60F&sms=BF7D6D478B935644' },
  { label: { 'zh-tw': '金門縣文化局：古寧頭戰役紀念活動', 'zh-cn': '金门县文化局：古宁头战役纪念活动', en: 'Kinmen Cultural Affairs Bureau: Guningtou commemorations' }, href: 'https://kccad.kinmen.gov.tw/News_Content.aspx?n=1401293451C14B5D&s=8D213EF24657CE09&sms=41E369FD1B4C8BC0' },
  { label: { 'zh-tw': '金門觀光：古寧頭戰場線', 'zh-cn': '金门观光：古宁头战场线', en: 'Kinmen Tourism: Guningtou battlefield route' }, href: 'https://www.kinmen.travel/zh-tw/discover/tour/171' },
];

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---

<MainLayout lang={lang} title={text({ 'zh-tw': '戰後金門：從戰地到和平生活', 'zh-cn': '战后金门：从战地到和平生活', en: 'Post-War Kinmen: From Frontline to Shared Peace' }) + ' · ' + text({ 'zh-tw': '古寧頭戰役 1949', 'zh-cn': '古宁头战役 1949', en: 'Battle of Guningtou 1949' })}>
  <div class="museum-page">
    <div class="museum-reading">
      <SectionHeading
        level={1}
        index="01"
        eyebrow="POST-WAR KINMEN · 1956—NOW"
        title={text({ 'zh-tw': '戰後金門：從戰地到和平生活', 'zh-cn': '战后金门：从战地到和平生活', en: 'Post-War Kinmen: From Frontline to Shared Peace' })}
        description={text({
          'zh-tw': '古寧頭之後，金門經歷八二三砲戰、戰地政務、開放觀光、國家公園保存與營區活化。這一頁把軍事地景放回居民生活、祭祀、觀光與兩岸交流的長時段脈絡。',
          'zh-cn': '古宁头之后，金门经历八二三炮战、战地政务、开放观光、国家公园保存与营区活化。本页把军事地景放回居民生活、祭祀、观光与两岸交流的长时段脉络。',
          en: 'After Guningtou, Kinmen experienced the 1958 crisis, battlefield administration, the opening of tourism, National Park conservation, and the adaptive reuse of military sites. This page places military landscapes within the longer history of civilian life, ritual, tourism, and cross-Strait exchange.',
        })}
      />

      <div class="museum-callout museum-callout--archive museum-postwar-note">
        <h2 class="museum-callout__title">{text(labels.note)}</h2>
        <p class="museum-callout__body">{text(labels.noteBody)}</p>
      </div>

      <section class="museum-content-section">
        <div class="museum-content-section__heading">
          <span class="museum-category-mark museum-category-mark--roc">T</span>
          <h2 class="text-xl font-serif font-bold">{text(labels.timeline)}</h2>
        </div>
        <div class="museum-timeline-list">
          {timeline.map((item) => (
            <article class="museum-context-card">
              <div class="museum-postwar-timeline__date">{item.date}</div>
              <h3>{text(item.title)}</h3>
              <p>{text(item.body)}</p>
              <div class="museum-postwar-card__links">
                {item.link && <a class="museum-link" href={sitePath(item.link, lang)}>{text(labels.routeMap)} →</a>}
                {item.source && <a class="museum-link" href={item.source} target="_blank" rel="noopener noreferrer">{text(labels.sourcePrefix)}{text(labels.officialSource)} ↗</a>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="museum-content-section">
        <div class="museum-content-section__heading">
          <span class="museum-category-mark museum-category-mark--geographic">C</span>
          <h2 class="text-xl font-serif font-bold">{text(labels.coast)}</h2>
        </div>
        <p class="museum-deck">{text(labels.coastIntro)}</p>
        <div class="museum-postwar-location-grid">
          {locationNodes.map((node) => (
            <article class="museum-postwar-location-card">
              <div class="museum-postwar-location-card__code">{node.code}</div>
              <h3>{text(node.name)}</h3>
              <p>{text(node.role)}</p>
              <div class="museum-postwar-location-card__note">{text(node.note)}</div>
              {node.poiId && <a class="museum-link" href={sitePath('locations/' + node.poiId, lang)}>{text(labels.openLocation)} →</a>}
              {!node.poiId && <span class="museum-postwar-pending">{text(labels.registerPending)}</span>}
            </article>
          ))}
        </div>
        <div class="museum-callout museum-callout--small museum-postwar-note">
          <p class="museum-callout__body">{text(labels.workBandNote)}</p>
        </div>
      </section>

      <section class="museum-content-section">
        <div class="museum-content-section__heading">
          <span class="museum-category-mark museum-category-mark--archive">R</span>
          <h2 class="text-xl font-serif font-bold">{text(labels.transformation)}</h2>
        </div>
        <div class="museum-postwar-card-grid">
          {transformationCards.map((card) => (
            <article class="museum-content-card museum-postwar-card">
              <div class="museum-postwar-card__mark">{card.mark}</div>
              <h3>{text(card.title)}</h3>
              <p>{text(card.body)}</p>
              <a class="museum-link" href={card.source} target="_blank" rel="noopener noreferrer">{text(labels.officialSource)} ↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="museum-content-section">
        <div class="museum-content-section__heading">
          <span class="museum-category-mark museum-category-mark--civilian">M</span>
          <h2 class="text-xl font-serif font-bold">{text(labels.memory)}</h2>
        </div>
        <div class="museum-postwar-card-grid">
          {memoryCards.map((card) => (
            <article class="museum-content-card museum-postwar-card">
              <div class="museum-postwar-card__mark">{card.mark}</div>
              <h3>{text(card.title)}</h3>
              <p>{text(card.body)}</p>
              <a class="museum-link" href={card.source} target="_blank" rel="noopener noreferrer">{text(labels.officialSource)} ↗</a>
            </article>
          ))}
        </div>
      </section>

      <section class="museum-content-section">
        <div class="museum-content-section__heading">
          <span class="museum-category-mark museum-category-mark--roc">F</span>
          <h2 class="text-xl font-serif font-bold">{text(labels.future)}</h2>
        </div>
        <div class="museum-postwar-future-list">
          {futureItems.map((item) => (
            <article class="museum-context-card museum-postwar-future-item">
              <div class="museum-postwar-future-item__mark">{item.mark}</div>
              <div>
                <h3>{text(item.title)}</h3>
                <p>{text(item.body)}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="museum-content-section museum-postwar-sources">
        <div class="museum-content-section__heading">
          <span class="museum-category-mark museum-category-mark--archive">S</span>
          <h2 class="text-xl font-serif font-bold">{text(labels.sources)}</h2>
        </div>
        <p class="museum-deck">{text({ 'zh-tw': '本頁以官方機關與既有本站來源作為入口；它不是完整年度建設清單。後續若要把工作帶節點納入地圖，仍需逐項補上可追溯證據。', 'zh-cn': '本页以官方机关与既有本站来源作为入口；它不是完整年度建设清单。后续若要把工作带节点纳入地图，仍需逐项补上可追溯证据。', en: 'This page uses official agencies and existing site sources as entry points; it is not a complete annual works register. Any future map integration of the working-band nodes still requires traceable evidence for each item.' })}</p>
        <div class="museum-postwar-source-list">
          {sourceLinks.map((source) => (
            <a class="museum-postwar-source-link" href={source.href} target="_blank" rel="noopener noreferrer">
              <span>{text(source.label)}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</MainLayout>
