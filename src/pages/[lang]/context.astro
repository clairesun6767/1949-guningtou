---
// /context — 戰前國際情勢（1945-1949）
import MainLayout from '../../layouts/MainLayout.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---




<MainLayout lang={Astro.params.lang}>
  <div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-serif font-bold mb-2">戰前國際情勢</h1>
    <p class="text-stone-500 mb-10">1945 — 1949 · 從二戰結束到台海對峙前夜</p>

    <!-- Timeline sections -->
    <div class="space-y-8">
      <section class="bg-white rounded-xl border border-stone-200 p-6">
        <div class="text-amber-600 font-bold text-sm mb-2">1945 年 8 月</div>
        <h2 class="text-xl font-serif font-bold mb-3">二戰結束，日本投降</h2>
        <p class="text-stone-600 leading-relaxed">
          8 月 15 日，日本宣布無條件投降。第二次世界大戰正式結束。台灣依據《開羅宣言》與《波茨坦公告》歸還中華民國。中國戰區的勝利並未帶來和平——國共兩黨的軍事衝突隨即在華北、東北重新點燃。
        </p>
      </section>

      <section class="bg-white rounded-xl border border-stone-200 p-6">
        <div class="text-amber-600 font-bold text-sm mb-2">1946 年 6 月</div>
        <h2 class="text-xl font-serif font-bold mb-3">國共內戰全面爆發</h2>
        <p class="text-stone-600 leading-relaxed">
          國民黨軍隊向中共控制區發動全面進攻，內戰正式開啟。初期國軍佔據兵力與裝備優勢，控制主要城市與交通線。共軍採取遊擊戰與運動戰策略，逐步消耗國軍力量。
        </p>
      </section>

      <section class="bg-white rounded-xl border border-stone-200 p-6">
        <div class="text-amber-600 font-bold text-sm mb-2">1948 年 9 月 — 1949 年 1 月</div>
        <h2 class="text-xl font-serif font-bold mb-3">三大戰役：國軍主力潰敗</h2>
        <p class="text-stone-600 leading-relaxed">
          遼瀋戰役（1948.9-11）、淮海戰役（1948.11-1949.1）、平津戰役（1948.12-1949.1）——解放軍接連取得決定性勝利。國軍損失超過 150 萬人，長江以北盡失。1949 年 1 月，蔣介石宣布下野，李宗仁代理總統。
        </p>
      </section>

      <section class="bg-white rounded-xl border border-stone-200 p-6">
        <div class="text-amber-600 font-bold text-sm mb-2">1949 年 4 月</div>
        <h2 class="text-xl font-serif font-bold mb-3">渡江戰役，南京淪陷</h2>
        <p class="text-stone-600 leading-relaxed">
          4 月 20 日，解放軍發起渡江戰役，百萬大軍跨越長江。4 月 23 日，南京淪陷。中華民國政府先遷廣州，後遷重慶，最終遷往台北。中國大陸的戰局已不可逆轉。
        </p>
      </section>

      <section class="bg-white rounded-xl border border-stone-200 p-6">
        <div class="text-amber-600 font-bold text-sm mb-2">1949 年 8 月</div>
        <h2 class="text-xl font-serif font-bold mb-3">美國發表《中美關係白皮書》</h2>
        <p class="text-stone-600 leading-relaxed">
          美國國務院發表白皮書，將中國內戰的失敗歸咎於國民黨政府的腐敗與無能。美國對中華民國政府的軍事援助大幅減少，台灣海峽成為國共對峙的最後防線。
        </p>
      </section>

      <section class="bg-white rounded-xl border border-stone-200 p-6">
        <div class="text-amber-600 font-bold text-sm mb-2">1949 年 10 月 1 日</div>
        <h2 class="text-xl font-serif font-bold mb-3">中華人民共和國成立</h2>
        <p class="text-stone-600 leading-relaxed">
          毛澤東在北京天安門廣場宣布中華人民共和國成立。同日，解放軍第十兵團已推進至福建沿海，與金門隔海相望。廈門於 10 月 17 日淪陷，金門成為台灣海峽的第一道防線。
        </p>
      </section>

      <section class="bg-white rounded-xl border border-stone-200 p-6">
        <div class="text-amber-600 font-bold text-sm mb-2">1949 年 10 月 17 日</div>
        <h2 class="text-xl font-serif font-bold mb-3">廈門淪陷 · 金門岌岌可危</h2>
        <p class="text-stone-600 leading-relaxed">
          解放軍第十兵團攻佔廈門。金門與廈門僅相隔約 10 公里的海峽，國軍守軍約兩萬人，面對解放軍數萬兵力的威脅。湯恩伯奉命固守金門，國軍船艦被封鎖於港口待命。
        </p>
        <p class="text-stone-500 text-sm mt-3">
          解放軍將領蕭鋒開始擬定渡海作戰計劃。潮汐、風向、船隻不足等問題將在接下來的戰役中成為決定性因素。
        </p>
      </section>

      <section class="bg-amber-50 rounded-xl border border-amber-200 p-6 text-center">
        <p class="text-stone-600 leading-relaxed">
          1949 年 10 月 24 日晚，解放軍第一梯隊約 9,000 人從廈門出發，航向金門古寧頭海岸。
        </p>
        <a href="./timeline" class="inline-block mt-4 text-amber-700 font-bold hover:text-amber-900 no-underline">
          進入四日戰役時間軸 →
        </a>
      </section>
    </div>
  </div>
</MainLayout>
