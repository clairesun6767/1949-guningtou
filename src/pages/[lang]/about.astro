---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeading from '../../components/museum/SectionHeading.astro';
import { STATS } from '../../data/loader';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---




<MainLayout lang={Astro.params.lang}>
  <div class="museum-page">
    <div class="museum-reading">
      <SectionHeading level={1} index="01" eyebrow="ABOUT THE MUSEUM" title="關於本站" description="這個平台以結構化史料與多元觀點，陪讀者從古寧頭的地理現場進入 1949 年的歷史。" />

    <div class="museum-content-card museum-space-after">
      <h2 class="museum-content-card__title">建站理念</h2>
      <p class="museum-content-card__quote">「以歷史見和平」</p>
      <p class="museum-content-card__body museum-content-card__body--lead">
        1949 年古寧頭戰役數位知識平台，旨在以客觀、多元的史料為基礎，
        呈現這場改變兩岸命運的關鍵戰役。我們不以勝負論英雄，
        而是透過理解歷史，反思戰爭的代價，珍惜和平的可貴。
      </p>
    </div>

    <div class="museum-content-card museum-space-after">
      <h2 class="museum-content-card__title">編輯原則</h2>
      <ul class="museum-content-card__list">
        <li><strong>多元史料</strong>：同時收錄國軍、共軍與第三方來源，不自行判定正確性</li>
        <li><strong>明確標示來源</strong>：所有陳述附原始出處，讀者可追溯查證</li>
        <li><strong>觀點透明</strong>：同一事件如存在不同記載，全部並列呈現並標明來源</li>
        <li><strong>政治中立</strong>：不以任何政治立場為敘事核心，聚焦歷史事實</li>
        <li><strong>歷史與創作分離</strong>：史料與推測/創作內容明確區分，不混淆</li>
      </ul>
    </div>

    <div class="museum-content-card museum-space-after">
      <h2 class="museum-content-card__title">資料規模</h2>
      <div class="museum-stat-grid">
        <div class="museum-stat-tile">
          <div class="museum-stat-tile__value">{STATS.totalTimeline}</div>
          <div class="museum-stat-tile__label">時間點</div>
        </div>
        <div class="museum-stat-tile">
          <div class="museum-stat-tile__value">{STATS.totalEvents}</div>
          <div class="museum-stat-tile__label">歷史事件</div>
        </div>
        <div class="museum-stat-tile">
          <div class="museum-stat-tile__value">{STATS.totalPOIs}</div>
          <div class="museum-stat-tile__label">戰役地點</div>
        </div>
        <div class="museum-stat-tile">
          <div class="museum-stat-tile__value">{STATS.totalPersons}</div>
          <div class="museum-stat-tile__label">人物</div>
        </div>
        <div class="museum-stat-tile">
          <div class="museum-stat-tile__value">{STATS.totalSources}</div>
          <div class="museum-stat-tile__label">文獻來源</div>
        </div>
        <div class="museum-stat-tile">
          <div class="museum-stat-tile__value">91</div>
          <div class="museum-stat-tile__label">靜態頁面</div>
        </div>
      </div>
    </div>

    <div class="museum-content-card museum-space-after">
      <h2 class="museum-content-card__title">技術</h2>
      <p class="museum-content-card__body museum-content-card__body--small">
        本站以 Astro + React + TypeScript + Tailwind CSS 建置，部署於 GitHub Pages。
        資料來源為 Battlefield Research Database（結構化 JSON），支援多史觀並存與三語呈現。
        1944 年航照由中央研究院 GIS 中心提供。
      </p>
    </div>

    <div class="museum-content-card museum-space-after">
      <h2 class="museum-content-card__title">著作權說明</h2>
      <p class="museum-content-card__body museum-content-card__body--small">
        本站文字內容基於公開史料編寫。照片與多媒體素材之著作權歸屬原权利人所有，
        使用前請確認授權狀態。1944 年航照影像由中央研究院人文社會科學研究中心
        地理資訊科學研究專題中心提供。
      </p>
    </div>

    <div class="museum-page__credit">
      <p>古寧頭戰役數位知識平台 · v1.0</p>
      <p>以歷史見和平 · Learning Peace Through History</p>
    </div>
    </div>
  </div>
</MainLayout>
