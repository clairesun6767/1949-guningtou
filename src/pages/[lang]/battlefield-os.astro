---
import MainLayout from '../../layouts/MainLayout.astro';
import BattleMap from '../../components/map/BattleMap';
import SectionHeading from '../../components/museum/SectionHeading.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---

<MainLayout lang={Astro.params.lang} title="Battlefield OS · 1949 古寧頭戰役">
  <BattleMap client:only="react" lang={Astro.params.lang} />
  <section class="museum-section museum-section--compact">
    <div class="museum-reading">
      <SectionHeading index="01" eyebrow="HISTORY FIRST" title="從精確路線，轉向可查證的空間敘事" description="新版 Battlefield OS 以人工驗證地點作為地理 SSOT；未獲史料支持的路線不在 Production map 顯示。Direction、Area、Corridor 與 Front 已建立資料介面，待研究資料通過審查後再加入。" />
      <div class="museum-callout museum-callout--archive">
        <h3 class="museum-callout__title">目前的誠實邊界</h3>
        <p class="museum-callout__body">六處 verified Locations 可以探索；canonical routes、battle areas、events 與 camera cues 仍是空資料。1944 航照只作歷史影像閱讀，尚未完成 GCP 與 georeference，因此不宣稱與地形精確對齊。</p>
      </div>
    </div>
  </section>
</MainLayout>

