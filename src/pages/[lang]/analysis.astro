---
// /analysis — 戰役解析：依事件類型拆解
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeading from '../../components/museum/SectionHeading.astro';
import { events } from '../../data/loader';

// Group events by type
const eventGroups: Record<string, typeof events> = {};
events.forEach(e => {
  const t = e.event_type ?? 'other';
  if (!eventGroups[t]) eventGroups[t] = [];
  eventGroups[t].push(e);
});

const TYPE_LABELS: Record<string, { icon: string; label: string }> = {
  amphibious_assault: { icon: 'A', label: '登陸作戰' },
  counterattack: { icon: 'C', label: '反擊作戰' },
  battle_engagement: { icon: 'E', label: '交戰' },
  village_combat: { icon: 'V', label: '村落戰' },
  urban_warfare: { icon: 'U', label: '城鎮戰' },
  encirclement: { icon: 'R', label: '包圍戰' },
  final_battle: { icon: 'F', label: '最終戰役' },
  battle_end: { icon: 'X', label: '戰役結束' },
  aftermath: { icon: 'P', label: '戰後處理' },
  command_change: { icon: 'K', label: '指揮變更' },
  killed_in_action: { icon: 'D', label: '陣亡' },
  naval_operation: { icon: 'N', label: '海上作戰' },
  air_operation: { icon: 'W', label: '空中作戰' },
};

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---




<MainLayout lang={Astro.params.lang}>
  <div class="museum-page">
    <div class="museum-container">
      <SectionHeading level={1} index="01" eyebrow="BATTLE ANALYSIS" title="戰役解析" description={`${events.length} 個歷史事件 · 依類型拆解。展開事件後可查看參與單位、指揮官、時間與證據等級。`} />

    <div class="museum-analysis-list">
      {Object.entries(eventGroups).map(([type, evts]) => {
        const meta = TYPE_LABELS[type] ?? { icon: '•', label: type };
        return (
          <section class="museum-analysis-group">
            <div class="museum-analysis-group__header">
              <span class="museum-analysis-group__icon">{meta.icon}</span>
              <h2 class="museum-analysis-group__title">{meta.label}</h2>
              <span class="museum-analysis-group__count">{evts.length} 事件</span>
            </div>
            <div class="museum-analysis-group__events">
              {evts.map(e => (
                <details class="museum-analysis-event group">
                  <summary class="museum-analysis-event__summary">
                    <span class="text-amber-400 mt-0.5 group-open:rotate-90 transition-transform">▶</span>
                    <div>
                      <h3 class="text-sm font-medium text-stone-800">{e.title}</h3>
                      <p class="text-xs text-stone-400 mt-0.5">
                        {e.date} · {e.location ?? '位置未詳'} · {e.time_precision ?? ''}
                      </p>
                    </div>
                  </summary>
                  <div class="museum-analysis-event__body">
                    {e.description && (
                      <p class="text-sm text-stone-600 leading-relaxed mb-3">{e.description}</p>
                    )}
                    <div class="museum-analysis-meta-grid">
                      {e.roc_units && (
                        <div class="museum-analysis-meta museum-analysis-meta--roc">
                          <span class="font-medium text-blue-700">國軍：</span>
                          <span class="text-stone-600">{e.roc_units}</span>
                        </div>
                      )}
                      {e.pla_units && (
                        <div class="museum-analysis-meta museum-analysis-meta--pla">
                          <span class="font-medium text-red-700">共軍：</span>
                          <span class="text-stone-600">{e.pla_units}</span>
                        </div>
                      )}
                      {e.commanders && (
                        <div class="museum-analysis-meta museum-analysis-meta--archive">
                          <span class="font-medium text-stone-600">指揮官：</span>
                          <span class="text-stone-500">{e.commanders}</span>
                        </div>
                      )}
                      {e.participants && (
                        <div class="museum-analysis-meta museum-analysis-meta--archive">
                          <span class="font-medium text-stone-600">參與者：</span>
                          <span class="text-stone-500">{e.participants}</span>
                        </div>
                      )}
                    </div>
                    {e.evidence_level && (
                      <div class="museum-analysis-event__evidence">
                        <span class={`evidence-badge evidence-${e.evidence_level}`}>證據 {e.evidence_level}</span>
                      </div>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </section>
        );
      })}
    </div>
    </div>
  </div>
</MainLayout>
