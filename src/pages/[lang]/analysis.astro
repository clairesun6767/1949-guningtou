---
// /analysis — 戰役解析：依事件類型拆解
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeading from '../../components/museum/SectionHeading.astro';
import { events } from '../../data/loader';
import { getEventCopy, toSimplified } from '../../i18n/historicalContent';

const lang = Astro.params.lang ?? 'zh-tw';
const isEnglish = lang === 'en';
const isSimplified = lang === 'zh-cn';

// Group events by type
const eventGroups: Record<string, typeof events> = {};
events.forEach(e => {
  const t = e.event_type ?? 'other';
  if (!eventGroups[t]) eventGroups[t] = [];
  eventGroups[t].push(e);
});

const TYPE_LABELS: Record<string, { icon: string; label: string }> = {
  amphibious_assault: { icon: 'A', label: 'Amphibious assault' },
  counterattack: { icon: 'C', label: 'Counterattack' },
  battle_engagement: { icon: 'E', label: 'Engagement' },
  village_combat: { icon: 'V', label: 'Village combat' },
  urban_warfare: { icon: 'U', label: 'Urban warfare' },
  encirclement: { icon: 'R', label: 'Encirclement' },
  final_battle: { icon: 'F', label: 'Final battle' },
  battle_end: { icon: 'X', label: 'Battle end' },
  aftermath: { icon: 'P', label: 'Aftermath' },
  command_change: { icon: 'K', label: 'Command change' },
  killed_in_action: { icon: 'D', label: 'Killed in action' },
  naval_operation: { icon: 'N', label: 'Naval operation' },
  air_operation: { icon: 'W', label: 'Air operation' },
};

const TYPE_LABELS_ZH: Record<string, string> = {
  amphibious_assault: '登陸作戰', counterattack: '反擊作戰', battle_engagement: '交戰', village_combat: '村落戰',
  urban_warfare: '城鎮戰', encirclement: '包圍戰', final_battle: '最終戰役', battle_end: '戰役結束', aftermath: '戰後處理',
  command_change: '指揮變更', killed_in_action: '陣亡', naval_operation: '海上作戰', air_operation: '空中作戰',
};

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---




<MainLayout lang={lang}>
  <div class="museum-page">
    <div class="museum-container">
      <SectionHeading level={1} index="01" eyebrow="BATTLE ANALYSIS" title={isEnglish ? 'Battle analysis' : isSimplified ? '战役解析' : '戰役解析'} description={isEnglish ? `${events.length} historical events · grouped by type. Expand an event to view participating units, commanders, time, and evidence level.` : isSimplified ? `${events.length} 个历史事件 · 按类型拆解。展开事件后可查看参与单位、指挥官、时间与证据等级。` : `${events.length} 個歷史事件 · 依類型拆解。展開事件後可查看參與單位、指揮官、時間與證據等級。`} />

    <div class="museum-analysis-list">
      {Object.entries(eventGroups).map(([type, evts]) => {
        const meta = isEnglish
          ? (TYPE_LABELS[type] ?? { icon: '•', label: type })
          : { icon: TYPE_LABELS[type]?.icon ?? '•', label: isSimplified ? toSimplified(TYPE_LABELS_ZH[type] ?? type) : TYPE_LABELS_ZH[type] ?? type };
        return (
          <section class="museum-analysis-group">
            <div class="museum-analysis-group__header">
              <span class="museum-analysis-group__icon">{meta.icon}</span>
              <h2 class="museum-analysis-group__title">{meta.label}</h2>
              <span class="museum-analysis-group__count">{evts.length} {isEnglish ? 'events' : isSimplified ? '个事件' : '事件'}</span>
            </div>
            <div class="museum-analysis-group__events">
              {evts.map(e => (
                (() => {
                  const copy = getEventCopy(e, lang);
                  return (
                <details class="museum-analysis-event group">
                  <summary class="museum-analysis-event__summary">
                    <span class="text-amber-400 mt-0.5 group-open:rotate-90 transition-transform">▶</span>
                    <div>
                        <h3 class="text-sm font-medium text-stone-800">{copy.title}</h3>
                      <p class="text-xs text-stone-400 mt-0.5">
                        {e.date} · {copy.location} · {e.time_precision ?? ''}
                      </p>
                    </div>
                  </summary>
                  <div class="museum-analysis-event__body">
                    {e.description && (
                        <p class="text-sm text-stone-600 leading-relaxed mb-3">{copy.description}</p>
                    )}
                    <div class="museum-analysis-meta-grid">
                      {e.roc_units && (
                        <div class="museum-analysis-meta museum-analysis-meta--roc">
                        <span class="font-medium text-blue-700">{isEnglish ? 'ROC: ' : '國軍：'}</span>
                          <span class="text-stone-600">{copy.rocUnits}</span>
                        </div>
                      )}
                      {e.pla_units && (
                        <div class="museum-analysis-meta museum-analysis-meta--pla">
                        <span class="font-medium text-red-700">{isEnglish ? 'PLA: ' : '共軍：'}</span>
                          <span class="text-stone-600">{copy.plaUnits}</span>
                        </div>
                      )}
                      {e.commanders && (
                        <div class="museum-analysis-meta museum-analysis-meta--archive">
                        <span class="font-medium text-stone-600">{isEnglish ? 'Commanders: ' : '指揮官：'}</span>
                          <span class="text-stone-500">{copy.commanders}</span>
                        </div>
                      )}
                      {e.participants && (
                        <div class="museum-analysis-meta museum-analysis-meta--archive">
                        <span class="font-medium text-stone-600">{isEnglish ? 'Participants: ' : '參與者：'}</span>
                          <span class="text-stone-500">{copy.participants}</span>
                        </div>
                      )}
                    </div>
                    {e.evidence_level && (
                      <div class="museum-analysis-event__evidence">
                        <span class={`evidence-badge evidence-${e.evidence_level}`}>{isEnglish ? 'Evidence' : '證據'} {e.evidence_level}</span>
                      </div>
                    )}
                  </div>
                </details>
                  );
                })()
              ))}
            </div>
          </section>
        );
      })}
    </div>
    </div>
  </div>
</MainLayout>
