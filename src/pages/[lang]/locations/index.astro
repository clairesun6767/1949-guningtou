---
import MainLayout from '../../../layouts/MainLayout.astro';
import LocationExplorer from '../../../components/map/LocationExplorer';
import SectionHeading from '../../../components/museum/SectionHeading.astro';
import { pois } from '../../../data/loader';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---




<MainLayout lang={Astro.params.lang}>
  <div class="museum-page">
    <div class="museum-container">
      <SectionHeading level={1} index="01" eyebrow="PLACE & TERRAIN" title="地點探索" description={`${pois.length} 個古寧頭戰役相關地點。選取地點後在地圖上定位，或進入檔案查看座標、戰役角色與來源狀態。`} />
      <LocationExplorer client:only="react" lang={Astro.params.lang} />
    </div>
  </div>
</MainLayout>
