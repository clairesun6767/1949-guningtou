---
import MainLayout from '../../../layouts/MainLayout.astro';
import LocationExplorer from '../../../components/map/LocationExplorer';
import SectionHeading from '../../../components/museum/SectionHeading.astro';
import { pois } from '../../../data/loader';

const lang = Astro.params.lang ?? 'zh-tw';
const isEnglish = lang === 'en';
const isSimplified = lang === 'zh-cn';
const publicPoiCount = pois.filter((poi) => (poi.map_visibility ?? (poi.coordinate_status === 'modern_verified' || poi.coordinate_status === 'representative' ? 'public' : 'research')) === 'public').length;

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---




<MainLayout lang={lang}>
  <div class="museum-page">
    <div class="museum-container">
      <SectionHeading level={1} index="01" eyebrow="PLACE & TERRAIN" title={isEnglish ? 'Explore locations' : isSimplified ? '地点探索' : '地點探索'} description={isEnglish ? `${publicPoiCount} public locations connected to the Battle of Guningtou. Select a place to locate it on the map, or open its record for coordinates, battle role, and source status.` : isSimplified ? `${publicPoiCount} 个公开显示的古宁头战役相关地点。选择地点后在地图上定位，或打开档案查看坐标、战役角色与来源状态。` : `${publicPoiCount} 個公開顯示的古寧頭戰役相關地點。選取地點後在地圖上定位，或進入檔案查看座標、戰役角色與來源狀態。`} />
      <LocationExplorer client:only="react" lang={lang} />
    </div>
  </div>
</MainLayout>
