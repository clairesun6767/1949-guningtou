---
import MainLayout from '../../../layouts/MainLayout.astro';
import MiniMap from '../../../components/map/MiniMap';
import MetadataRow from '../../../components/museum/MetadataRow.astro';
import SourceCitation from '../../../components/museum/SourceCitation.astro';
import { sitePath } from '../../../data/paths';
import { pois } from '../../../data/loader';

export function getStaticPaths() {
  const langs = ['zh-tw', 'zh-cn', 'en'];
  const paths = [];
  for (const lang of langs) {
    for (const poi of pois) paths.push({ params: { lang, id: poi.poi_id } });
  }
  return paths;
}

const { id, lang } = Astro.params;
const poi = pois.find((item) => item.poi_id === id);
---

<MainLayout lang={lang}>
  {poi ? (
    <div class="museum-page">
      <div class="museum-container">
        <a href={sitePath('locations', lang)} class="museum-link">← 回到地點探索</a>
        <div class="museum-location-detail">
          <div class="museum-location-detail__copy">
            <div class="museum-kicker museum-space-before">PLACE RECORD · {poi.poi_id}</div>
            <h1 class="museum-title">{poi.name_chinese}</h1>
            {poi.name_english && <p class="museum-deck">{poi.name_english}</p>}

            <div class="museum-person-detail__status">
              {poi.evidence_level && <span class={`evidence-badge evidence-${poi.evidence_level}`}>證據 {poi.evidence_level}</span>}
              {poi.verification_status && <SourceCitation text={poi.verification_status} />}
            </div>

            {poi.historical_background && (
              <section class="museum-reading__section">
                <div class="museum-kicker">HISTORICAL BACKGROUND</div>
                <h2>歷史背景</h2>
                <p class="museum-prose">{poi.historical_background}</p>
              </section>
            )}

            {poi.battle_role && (
              <section class="museum-reading__section">
                <div class="museum-kicker">BATTLE ROLE</div>
                <h2>戰役角色</h2>
                <p class="museum-prose">{poi.battle_role}</p>
              </section>
            )}

            {poi.historical_context && (
              <section class="museum-reading__section">
                <div class="museum-kicker">CONTEXT</div>
                <h2>歷史脈絡</h2>
                <p class="museum-prose">{poi.historical_context}</p>
              </section>
            )}

            <div class="museum-meta-grid museum-location-detail__meta">
              <MetadataRow label="GPS 座標" value={`${poi.latitude}, ${poi.longitude}`} />
              <MetadataRow label="座標精度" value={poi.coordinate_accuracy} />
              <MetadataRow label="類別" value={poi.category} />
              <MetadataRow label="開放狀態" value={poi.open_status} />
            </div>
          </div>
          <aside class="museum-location-detail__map">
            <MiniMap client:only="react" lat={poi.latitude} lng={poi.longitude} name={poi.name_chinese} />
          </aside>
        </div>
      </div>
    </div>
  ) : (
    <div class="museum-page">
      <div class="museum-reading museum-centered">
        <div class="museum-kicker">RECORD NOT FOUND</div>
        <h1 class="museum-title">地點不存在</h1>
        <a class="museum-button" href={sitePath('locations', lang)}>回到地點探索</a>
      </div>
    </div>
  )}
</MainLayout>
