---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeading from '../../components/museum/SectionHeading.astro';

const lang = Astro.params.lang ?? 'zh-tw';
const isEnglish = lang === 'en';

const rocWeapons = [
  { name: 'M5A1 Stuart light tank', cat: 'Tank', desc: 'A key weapon in the battle. The ROC 3rd Tank Regiment, 1st Company operated it; vehicle 66 fired the first shot at Longkou. Weight: 15 tonnes; main gun: 37 mm; armour: 12–67 mm.', note: 'Vehicle 66 was operated by Hsiung Chen-Chiu', nameZh: 'M5A1 Stuart 輕戰車', catZh: '戰車', descZh: '古寧頭戰役關鍵裝備。國軍戰車第3團第1連配備，66號車在嚨口發射第一砲。重15噸，37mm主砲，裝甲厚度12-67mm。', noteZh: '66號車由熊震球操作' },
  { name: 'M1 Garand rifle', cat: 'Rifle', desc: 'Standard ROC infantry weapon. Chambered in .30-06 with an eight-round magazine, semi-automatic action, and an effective range of about 450 m.', note: 'U.S.-supplied equipment', nameZh: 'M1 格蘭德步槍', catZh: '步槍', descZh: '國軍標準步兵武器。.30-06口徑，8發彈倉，半自動，有效射程約450m。', noteZh: '美援裝備' },
  { name: 'M1917 Browning heavy machine gun', cat: 'Machine gun', desc: 'Water-cooled .30-06 heavy machine gun used in beach-defense positions to provide sustained suppressive fire.', note: '', nameZh: 'M1917 白朗寧重機槍', catZh: '機槍', descZh: '水冷式重機槍，.30-06口徑，用於灘頭防禦陣地，提供持續火力壓制。', noteZh: '' },
  { name: 'BAR M1918 automatic rifle', cat: 'Machine gun', desc: 'Squad automatic weapon in .30-06, using a 20-round magazine and capable of light-machine-gun employment.', note: '', nameZh: 'BAR M1918 自動步槍', catZh: '機槍', descZh: '班用自動武器，.30-06口徑，20發彈匣，可作為輕機槍使用。', noteZh: '' },
  { name: 'M2 60 mm mortar', cat: 'Artillery', desc: 'Portable company-level infantry support weapon for close-range fire support.', note: '', nameZh: 'M2 60mm 迫擊炮', catZh: '火炮', descZh: '步兵連級支援火力，輕便可攜，用於近距離火力支援。', noteZh: '' },
  { name: '75 mm mountain gun', cat: 'Artillery', desc: 'Used by ROC coastal artillery positions on northern Kinmen to fire on the landing fleet.', note: '', nameZh: '75mm 山炮', catZh: '火炮', descZh: '國軍岸防砲兵使用，部署於金門北部海岸，對登陸船團進行壓制射擊。', noteZh: '' },
  { name: 'SCR-300 radio', cat: 'Communications', desc: 'Backpack radio used for communication between infantry companies and battalion command posts.', note: 'World War II U.S. equipment', nameZh: 'SCR-300 無線電', catZh: '通信', descZh: '背負式無線電，用於步兵連與營指揮所之間的通訊。', noteZh: '二戰美軍裝備' },
  { name: 'M1 helmet', cat: 'Uniform', desc: 'Standard ROC helmet supplied through U.S. aid.', note: '', nameZh: 'M1 鋼盔', catZh: '制服', descZh: '國軍標準頭盔，美援裝備。', noteZh: '' },
];

const plaWeapons = [
  { name: 'Type Zhongzheng rifle', cat: 'Rifle', desc: 'Standard PLA rifle, chambered in 7.92×57 mm Mauser, with a bolt action and five-round internal magazine.', note: 'Copy of the German Kar98k', nameZh: '中正式步槍', catZh: '步槍', descZh: '解放軍標準步槍，7.92×57mm毛瑟口徑，手動槍機，5發內置彈倉。', noteZh: '仿德國Kar98k' },
  { name: 'Type 38 rifle', cat: 'Rifle', desc: 'Japanese 6.5 mm rifle. The PLA made extensive use of captured Japanese equipment.', note: 'World War II Japanese equipment', nameZh: '三八式步槍', catZh: '步槍', descZh: '日製步槍，6.5mm口徑，解放軍大量使用繳獲的日軍裝備。', noteZh: '二戰日軍裝備' },
  { name: 'ZB-26 light machine gun', cat: 'Machine gun', desc: 'Czech-designed 7.92 mm light machine gun with a 20-round magazine, used at squad level.', note: '', nameZh: 'ZB-26 輕機槍', catZh: '機槍', descZh: '捷克式輕機槍，7.92mm口徑，20發彈匣，解放軍班用主力。', noteZh: '' },
  { name: '60 mm mortar', cat: 'Artillery', desc: 'Light mortar used as company-level infantry support.', note: '', nameZh: '60mm 迫擊炮', catZh: '火炮', descZh: '輕型迫擊炮，解放軍步兵連級支援火力。', noteZh: '' },
  { name: 'Wooden sailboats and fishing boats', cat: 'Boats', desc: 'The PLA’s principal means of crossing the water. Most were requisitioned civilian boats without mechanical propulsion and were highly exposed to wind and waves.', note: 'The central bottleneck of the crossing', nameZh: '木製帆船／漁船', catZh: '船隻', descZh: '解放軍渡海主要工具。多為徵用的民船，木製帆船，無機械動力，受風浪影響極大。', noteZh: '渡海最大瓶頸' },
  { name: 'Hand grenades', cat: 'Equipment', desc: 'A principal close-combat weapon for PLA infantry during fighting after the landing.', note: '', nameZh: '手榴彈', catZh: '裝備', descZh: '解放軍步兵主要近戰武器，登陸後近距離交戰的重要火力。', noteZh: '' },
  { name: 'Cloth ammunition pouch', cat: 'Equipment', desc: 'Standard PLA equipment for carrying rifle ammunition and grenades.', note: '', nameZh: '布製彈藥袋', catZh: '裝備', descZh: '解放軍士兵標準裝備，攜帶步槍彈藥與手榴彈。', noteZh: '' },
  { name: 'Cotton uniform', cat: 'Uniform', desc: 'Standard PLA winter uniform without ballistic protection; becoming soaked after the crossing affected movement.', note: '', nameZh: '棉布軍服', catZh: '制服', descZh: '解放軍標準冬季軍服，無防彈功能，渡海後濕透影響行動。', noteZh: '' },
];

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---




<MainLayout lang={lang}>
  <div class="museum-page">
    <div class="museum-container">
      <SectionHeading level={1} index="01" eyebrow="MATERIAL CULTURE" title={isEnglish ? 'Weapons and equipment' : '武器裝備'} description={isEnglish ? 'Key weapons and equipment used by ROC and PLA forces at Guningtou. Read them through specifications, uses, and circumstances rather than turning equipment into game props.' : '國軍與共軍於古寧頭戰役使用的主要武器裝備。以規格、用途與使用情境閱讀物質條件，而不是把裝備做成遊戲道具。'} />

    <!-- ROC Weapons -->
    <section class="museum-content-section">
      <div class="museum-content-section__heading museum-content-section__heading--spacious">
        <span class="museum-category-mark museum-category-mark--roc">國</span>
        <h2 class="text-xl font-serif font-bold">{isEnglish ? 'ROC equipment' : '國軍裝備'}</h2>
      </div>
      <div class="museum-grid museum-grid--2 museum-equipment-grid">
        {rocWeapons.map(w => (
          <div class="museum-content-card museum-content-card--interactive museum-equipment-card">
            <div class="museum-equipment-card__heading">
            <h3 class="museum-content-card__title">{isEnglish ? w.name : w.nameZh}</h3>
              <span class="museum-tag museum-tag--roc">{isEnglish ? w.cat : w.catZh}</span>
            </div>
            <p class="museum-content-card__body museum-content-card__body--small">{isEnglish ? w.desc : w.descZh}</p>
            {(isEnglish ? w.note : w.noteZh) && <p class="museum-equipment-card__note">{isEnglish ? w.note : w.noteZh}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- PLA Weapons -->
    <section class="museum-content-section">
      <div class="museum-content-section__heading museum-content-section__heading--spacious">
        <span class="museum-category-mark museum-category-mark--pla">共</span>
        <h2 class="text-xl font-serif font-bold">{isEnglish ? 'PLA equipment' : '共軍裝備'}</h2>
      </div>
      <div class="museum-grid museum-grid--2 museum-equipment-grid">
        {plaWeapons.map(w => (
          <div class="museum-content-card museum-content-card--interactive museum-equipment-card">
            <div class="museum-equipment-card__heading">
            <h3 class="museum-content-card__title">{isEnglish ? w.name : w.nameZh}</h3>
              <span class="museum-tag museum-tag--pla">{isEnglish ? w.cat : w.catZh}</span>
            </div>
            <p class="museum-content-card__body museum-content-card__body--small">{isEnglish ? w.desc : w.descZh}</p>
            {(isEnglish ? w.note : w.noteZh) && <p class="museum-equipment-card__note">{isEnglish ? w.note : w.noteZh}</p>}
          </div>
        ))}
      </div>
    </section>

    <div class="museum-callout museum-callout--archive museum-callout--centered museum-callout--small">
      {isEnglish ? '🏗️ This section is still expanding — weapon specifications, historical photographs, and 3D models will be added later.' : '🏗️ 本章節持續擴充中 — 未來將加入武器規格表、歷史照片與 3D 模型'}
    </div>
    </div>
  </div>
</MainLayout>
