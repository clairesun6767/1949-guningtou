---
// 首頁 — 以航照、地點、時間與史料帶領使用者進入博物館
import MainLayout from '../../layouts/MainLayout.astro';
import HeroMap from '../../components/hero/HeroMap';
import HistoricImage from '../../components/museum/HistoricImage.astro';
import PersonCard from '../../components/museum/PersonCard.astro';
import EvidenceCard from '../../components/museum/EvidenceCard.astro';
import SectionHeading from '../../components/museum/SectionHeading.astro';
import { sitePath } from '../../data/paths';
import { STATS, events, persons, sources, pois } from '../../data/loader';
import { getEventCopy, getPoiCopy } from '../../i18n/historicalContent';

const lang = Astro.params.lang ?? 'zh-tw';
const isEnglish = lang === 'en';
const isSimplified = lang === 'zh-cn';

const thenNowCopy = isEnglish
  ? {
      eyebrow: 'THEN & NOW · 1949 → TODAY',
      title: 'The battlefield continues into the present.',
      body: 'A 1944 aerial reference, today’s museum, coastal sites, and existing location records place the post-war layers around the 1949 battle—without replacing the battle evidence itself.',
      button: 'Read Guningtou: Then & Now →',
      alt: 'Guningtou Battle Museum in 2013',
    }
  : isSimplified
    ? {
        eyebrow: '今昔阅读 · 1949 → 今日',
        title: '战场延伸到今天的地景。',
        body: '从 1944 航照参考、今日战史馆、海岸据点与既有地点记录出发，阅读 1949 战役周围的战后层次，同时不取代战役本身的史料证据。',
        button: '阅读《昔日战场・今日古宁头》→',
        alt: '2013 年古宁头战史馆',
      }
    : {
        eyebrow: '今昔閱讀 · 1949 → 今日',
        title: '戰場延伸到今天的地景。',
        body: '從 1944 航照參考、今日戰史館、海岸據點與既有地點記錄出發，閱讀 1949 戰役周圍的戰後層次，同時不取代戰役本身的史料證據。',
        button: '閱讀〈昔日戰場・今日古寧頭〉→',
        alt: '2013 年古寧頭戰史館',
      };

const battleDays = [
  {
    date: '10.24',
    label: '第一日', labelEn: 'Day one',
    title: '戰前準備與出發', titleEn: 'Preparation and departure',
    description: '第一梯隊從廈門出發。季風、潮汐與航線偏移，成為戰役開始前的重要條件。', descriptionEn: 'The first wave leaves Xiamen. Monsoon winds, tides, and route deviation shape the conditions before the battle begins.',
    count: events.filter((event) => event.date?.includes('1949-10-24')).length,
  },
  {
    date: '10.25',
    label: '第二日', labelEn: 'Day two',
    title: '登陸與交戰', titleEn: 'Landing and engagement',
    description: '凌晨第一砲響起，登陸部隊在古寧頭海岸與守軍交會。', descriptionEn: 'The first shot is fired before dawn as the landing force meets the defenders along the Guningtou coast.',
    count: events.filter((event) => event.date?.includes('1949-10-25')).length,
  },
  {
    date: '10.26',
    label: '第三日', labelEn: 'Day three',
    title: '增援與包圍', titleEn: 'Reinforcement and encirclement',
    description: '增援抵達後，戰線逐漸收縮，登陸部隊面臨補給與重武器的限制。', descriptionEn: 'As reinforcements arrive, the front contracts and the landing force faces limits in supply and heavy weapons.',
    count: events.filter((event) => event.date?.includes('1949-10-26')).length,
  },
  {
    date: '10.27',
    label: '第四日', labelEn: 'Day four',
    title: '戰役終局', titleEn: 'The battle ends',
    description: '戰事在北山一帶走向終局，留下分治、記憶與持續被閱讀的史料。', descriptionEn: 'Fighting reaches its end around Beishan, leaving a history of division, memory, and ongoing reading.',
    count: events.filter((event) => event.date?.includes('1949-10-27')).length,
  },
];

const featuredPeople = persons.slice(0, 3);
const featuredSources = sources.slice(0, 3);
const featuredEvents = events.slice(0, 3);
export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---

<MainLayout lang={lang}>
  <HeroMap client:only="react" base="/1949-guningtou" lang={lang} />

  <section class="museum-section museum-home-context">
    <div class="museum-container">
      <div class="museum-home-context__intro">
        <div class="museum-kicker">01 · CONTEXT</div>
        <h2>{isEnglish ? <>Not a battle diagram,<br />but a<span class="museum-title__nowrap"> living reading room.</span></> : isSimplified ? <>不是一张战况图，<br />而是一个仍在发生的<span class="museum-title__nowrap">阅读现场。</span></> : <>不是一張戰況圖，<br />而是一個仍在發生的<span class="museum-title__nowrap">閱讀現場。</span></>}</h2>
        <p>{isEnglish ? 'This digital museum returns the 1949 Battle of Guningtou to time, place, people, and sources, allowing memories from different positions to be placed side by side, checked, and understood.' : isSimplified ? '这座数字博物馆将 1949 年古宁头战役拆回时间、地点、人物与来源，让不同位置留下的记忆可以并置、查证，也被理解。' : '這座數位博物館將 1949 年古寧頭戰役拆回時間、地點、人物與來源，讓不同位置留下的記憶可以被並置、被查證，也被理解。'}</p>
      </div>
      <div class="museum-home-context__facts">
         <div class="museum-home-fact"><strong>1949</strong><span>{isEnglish ? 'A turning point in the Taiwan Strait' : isSimplified ? '台海局势急剧转折的年代' : '台海局勢急遽轉折的年代'}</span></div>
         <div class="museum-home-fact"><strong>4 DAYS</strong><span>{isEnglish ? '24–27 October 1949' : isSimplified ? '1949.10.24—10.27 的战役时间' : '1949.10.24—10.27 的戰役時間'}</span></div>
         <div class="museum-home-fact"><strong>1 PLACE</strong><span>{isEnglish ? 'Guningtou, Kinmen — a shared geographic ground' : isSimplified ? '金门古宁头，作为共同的地理现场' : '金門古寧頭，作為共同的地理現場'}</span></div>
      </div>
    </div>
  </section>

  <section class="museum-section museum-home-then-now">
    <div class="museum-container museum-home-then-now__grid">
      <HistoricImage
        src={sitePath('media/guningtou/then-now/g-battle-museum-2013.jpg')}
        alt={thenNowCopy.alt}
        caption={isEnglish ? 'Guningtou Battle Museum · 2013 · CC BY-SA 4.0' : '古寧頭戰史館 · 2013 · CC BY-SA 4.0'}
        source={isEnglish ? 'Wikimedia Commons · Mnb' : 'Wikimedia Commons · Mnb'}
        lang={lang}
      />
      <div class="museum-home-then-now__copy">
        <div class="museum-kicker">{thenNowCopy.eyebrow}</div>
        <h2>{thenNowCopy.title}</h2>
        <p>{thenNowCopy.body}</p>
        <a class="museum-button museum-button--outline" href={sitePath('then-and-now', lang)}>{thenNowCopy.button}</a>
      </div>
    </div>
  </section>

  <section class="museum-section museum-section--compact">
    <div class="museum-container">
      <SectionHeading index="02" eyebrow="ORIENTATION" title={isEnglish ? 'See the battlefield before entering the narrative' : '先看見戰場，再進入敘事'} description={isEnglish ? 'The 1944 aerial photograph preserves the scale of terrain and settlements. The map is not a backdrop; it is the first evidence for understanding landing, advance, and defense.' : '1944 年航照保留了地形與聚落的尺度。地圖不是背景，而是理解登陸、推進與防守的第一份證據。'} />
      <div class="museum-home-map-grid">
        <HistoricImage src="/1949-guningtou/aerial-1944a.png" alt={isEnglish ? '1944 aerial photograph of the Guningtou area' : '1944 年古寧頭地區航照圖'} caption={isEnglish ? 'Guningtou aerial photograph · open the original for detail' : '古寧頭地區航照 · 可開啟原始影像查看細節'} source={isEnglish ? 'Academia Sinica GIS Center' : '中央研究院 GIS 中心'} priority lang={lang} />
         <div class="museum-paper museum-home-map-note">
          <div class="museum-kicker">FIELD NOTE</div>
           <h3>{isEnglish ? 'Where did this happen?' : isSimplified ? '这里发生了什么？' : '這裡發生了什麼？'}</h3>
           <p>{isEnglish ? 'Longkou, Beishan, Lincuo, Nanshan, and Huwei are more than place names. They are spaces where troop movements, civilian life, and battle memories overlap.' : isSimplified ? '龙口、北山、林厝、南山与湖尾不只是地名，也是部队移动、居民生活与战斗记忆交叠的空间。' : '嚨口、北山、林厝、南山與湖尾，不只是地名。它們是部隊移動、居民生活與戰鬥記憶交疊的空間。'}</p>
          <div class="museum-meta-grid">
            <dl class="museum-meta"><dt>{isEnglish ? 'Location records' : '地點資料'}</dt><dd>{STATS.totalPOIs} POIs</dd></dl>
             <dl class="museum-meta"><dt>{isEnglish ? 'Core location' : isSimplified ? '核心位置' : '核心位置'}</dt><dd>{pois.slice(0, 1).map((poi) => getPoiCopy(poi, lang).name).join('、') || (isEnglish ? 'Guningtou' : isSimplified ? '古宁头' : '古寧頭')}</dd></dl>
          </div>
          <a class="museum-button museum-button--outline" href={sitePath('map', lang)}>{isEnglish ? 'Enter battle map →' : '進入戰役地圖 →'}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="museum-section museum-home-timeline">
    <div class="museum-container">
      <SectionHeading index="03" eyebrow="TIME RAIL" title={isEnglish ? 'Four days, unfolded step by step' : '四日戰役，逐段展開'} description={isEnglish ? 'From departure to the end, the timeline returns each event to its date, time, place, and evidence level.' : '從出發到終局，時間軸將事件放回發生的日期、時間、位置與證據等級。'} />
      <div class="museum-home-days">
        {battleDays.map((day) => (
          <a href={sitePath('timeline', lang)} class="museum-card museum-card-link museum-day-card">
            <div class="museum-day-card__date">{day.date}</div>
            <div class="museum-kicker">{isEnglish ? day.labelEn : day.label}</div>
            <h3>{isEnglish ? day.titleEn : day.title}</h3>
            <p>{isEnglish ? day.descriptionEn : day.description}</p>
            <div class="museum-citation">{day.count} {isEnglish ? 'organized events · open timeline →' : '個已整理事件 · 展開時間軸 →'}</div>
          </a>
        ))}
      </div>
      <div class="museum-home-timeline__footer">
        <span class="museum-meta">{STATS.totalTimeline} TIMELINE RECORDS · 1949.10.24—10.27</span>
        <a class="museum-link" href={sitePath('timeline', lang)}>{isEnglish ? 'View full timeline →' : '查看完整時間軸 →'}</a>
      </div>
    </div>
  </section>

  <section class="museum-section">
    <div class="museum-container">
      <SectionHeading index="04" eyebrow="PEOPLE" title={isEnglish ? 'War is experienced and remembered by people' : '戰爭由人經歷，也由人記得'} description={isEnglish ? 'The people records show more than a chain of command: they return soldiers, civilians, and accounts from different sides to their respective positions.' : '人物資料不只呈現指揮鏈，也把軍人、居民與不同陣營留下的敘述放回各自的位置。'} />
      <div class="museum-grid museum-grid--3">
        {featuredPeople.map((person) => <PersonCard person={person} lang={lang} href={sitePath(`figures/${person.person_id}`, lang)} />)}
      </div>
      <div class="museum-home-timeline__footer">
        <span class="museum-meta">{STATS.totalPersons} PERSON RECORDS</span>
        <a class="museum-link" href={sitePath('figures', lang)}>{isEnglish ? 'Browse people records →' : '瀏覽人物檔案 →'}</a>
      </div>
    </div>
  </section>

  <section class="museum-section museum-home-evidence">
    <div class="museum-container">
      <SectionHeading index="05" eyebrow="EVIDENCE" title={isEnglish ? 'Let sources be the entry point' : '讓史料成為入口'} description={isEnglish ? 'Every statement should have traceable provenance; where accounts differ, the difference itself is retained.' : '每一項陳述都應該有可追溯的來源；存在差異之處，則保留差異本身。'} />
      <div class="museum-grid museum-grid--3">
        {featuredSources.map((source) => <EvidenceCard source={source} lang={lang} />)}
      </div>
      <div class="museum-home-evidence__footer">
        <span class="museum-meta">{STATS.totalSources} SOURCES · PROVENANCE FIRST</span>
        <a class="museum-link" href={sitePath('sources', lang)}>{isEnglish ? 'Open source database →' : '進入文獻資料庫 →'}</a>
      </div>
    </div>
  </section>

  <section class="museum-section museum-section--compact">
    <div class="museum-container">
      <SectionHeading index="06" eyebrow="EVENTS" title={isEnglish ? 'Begin with one event' : '從一個事件開始追問'} description={isEnglish ? 'Read one specific moment, then follow its sources, people, and places outward.' : '先讀一個具體片刻，再沿著來源、人物與地點向外展開。'} />
      <div class="museum-grid museum-grid--3">
         {featuredEvents.map((event) => {
           const eventCopy = getEventCopy(event, lang);
           return (
          <article class="museum-card museum-home-event">
            <div class="museum-meta">{event.date}{event.time_start ? ` · ${event.time_start}` : ''}</div>
             <h3>{eventCopy.title}</h3>
             <p>{eventCopy.description}</p>
             <div class="museum-citation">{eventCopy.location} · {event.event_id}</div>
          </article>
           );
         })}
      </div>
      <div class="museum-home-timeline__footer">
        <a class="museum-link" href={sitePath('analysis', lang)}>{isEnglish ? 'Read by event type →' : '依事件類型閱讀 →'}</a>
        <a class="museum-link" href={sitePath('perspectives', lang)}>{isEnglish ? 'Compare perspectives →' : '比較多元史觀 →'}</a>
      </div>
    </div>
  </section>

  <section class="museum-section museum-home-explore">
    <div class="museum-container museum-home-explore__inner">
      <div>
        <div class="museum-kicker">07 · EXPLORE</div>
        <h2>{isEnglish ? 'You decide where to begin.' : '從哪裡開始，由你決定。'}</h2>
      </div>
      <div class="museum-home-explore__links">
        <a href={sitePath('timeline', lang)}>{isEnglish ? 'Timeline' : '時間軸'} <span>01</span></a>
        <a href={sitePath('map', lang)}>{isEnglish ? 'Battle map' : '戰場地圖'} <span>02</span></a>
        <a href={sitePath('figures', lang)}>{isEnglish ? 'People records' : '人物檔案'} <span>03</span></a>
        <a href={sitePath('archive', lang)}>{isEnglish ? 'Digital archive' : '數位典藏'} <span>04</span></a>
        <a href={sitePath('then-and-now', lang)}>{isEnglish ? 'Then & now' : isSimplified ? '今昔阅读' : '今昔閱讀'} <span>05</span></a>
      </div>
    </div>
  </section>

  <section class="museum-section museum-home-reflection">
    <div class="museum-reading">
      <div class="museum-kicker">08 · REFLECTION</div>
      <blockquote>{isEnglish ? '“We study war not to make it look impressive, but to see how it happened, who experienced it, and why peace is worth cherishing.”' : '「理解戰爭，不是為了讓戰爭看起來很酷；是為了看見它如何發生、誰曾經歷，以及和平為何值得被珍惜。」'}</blockquote>
      <a class="museum-button" href={sitePath('then-and-now', lang)}>{isEnglish ? 'Read from the post-war period to today →' : '閱讀戰後至今 →'}</a>
    </div>
  </section>
</MainLayout>
