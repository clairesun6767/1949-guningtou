---
// ============================================================
// 首頁 — 3D 地球主視覺 + 和平宣言 + 四日速覽 + 導航
// ============================================================
import MainLayout from '../../layouts/MainLayout.astro';
import { sitePath } from '../../data/paths';
import HeroMap from '../../components/hero/HeroMap';
import { STATS, timeline, events } from '../../data/loader';
const { lang } = Astro.params;

// 四日戰役摘要
const battleDays = [
  {
    date: '10/24',
    label: '第一日',
    title: '戰前準備與出發',
    description: '解放軍第一梯隊從廈門出發。強勁東北季風將船團吹離預定航線，往古寧頭方向偏移。國軍戰車排演習後一輛 M5A1 在嚨口拋錨。',
    events: events.filter(e => e.date?.includes('1949-10-24')).length,
  },
  {
    date: '10/25',
    label: '第二日',
    title: '登陸與交戰',
    description: '凌晨 00:30 熊震球發射第一砲。解放軍三個團在 10 公里灘頭登陸。國軍第 201 師與戰車部隊展開反擊。',
    events: events.filter(e => e.date?.includes('1949-10-25')).length,
  },
  {
    date: '10/26',
    label: '第三日',
    title: '國軍增援與包圍',
    description: '國軍增援部隊抵達，對登陸解放軍形成包圍。解放軍缺乏補給與重武器，戰況陷入膠著。',
    events: events.filter(e => e.date?.includes('1949-10-26')).length,
  },
  {
    date: '10/27',
    label: '第四日',
    title: '戰役終局',
    description: '解放軍殘部退至北山斷崖，彈盡援絕。古寧頭戰役結束，兩岸從此走向分治格局。',
    events: events.filter(e => e.date?.includes('1949-10-27')).length,
  },
];

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}
---




<MainLayout lang={Astro.params.lang}>
  <!-- ===== HERO: 3D 地球 ===== -->
  <HeroMap client:only="react" base={sitePath('', lang)} />

  <!-- ===== 和平宣言 ===== -->
  <section class="max-w-3xl mx-auto px-4 py-20 text-center">
    <blockquote class="font-serif text-xl md:text-2xl text-stone-600 leading-relaxed italic">
      「每一發砲彈落下之處，現在是潮汐來回的沙灘。」
    </blockquote>
    <p class="mt-6 text-stone-500 leading-relaxed max-w-2xl mx-auto">
      歷史已然發生，無法改變。<br />
      我們無意評判對錯，只願呈現那些發生在金門海岸上的真實片刻。
    </p>
    <p class="mt-4 text-stone-700 font-medium">
      理解戰爭，是為了不必再經歷戰爭。
    </p>
  </section>

  <!-- ===== 為何研究古寧頭 ===== -->
  <section class="max-w-3xl mx-auto px-4 pb-16 text-center">
    <h2 class="text-xl font-serif font-bold text-stone-700 mb-6">為何研究古寧頭？</h2>
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <div class="text-2xl mb-2">🌏</div>
        <h3 class="font-bold text-stone-700 text-sm">1949 是什麼年代？</h3>
        <p class="text-xs text-stone-500 mt-1">二戰結束、冷戰開始、國共內戰 — 古寧頭是這個時代的縮影。</p>
      </div>
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <div class="text-2xl mb-2">📖</div>
        <h3 class="font-bold text-stone-700 text-sm">多史觀並存</h3>
        <p class="text-xs text-stone-500 mt-1">國軍、共軍、居民 — 三種視角，同一場戰役，不同的記憶。</p>
      </div>
      <div class="bg-white rounded-xl border border-stone-200 p-5">
        <div class="text-2xl mb-2">🕊️</div>
        <h3 class="font-bold text-stone-700 text-sm">以歷史見和平</h3>
        <p class="text-xs text-stone-500 mt-1">理解戰爭的代價，是為了珍惜今日的和平。</p>
      </div>
    </div>
    <div class="mt-8">
      <a href="./timeline" class="inline-block px-6 py-3 bg-amber-600 text-white rounded-lg font-medium hover:bg-amber-700 transition no-underline">
        進入歷史 →
      </a>
    </div>
  </section>

  <!-- ===== 四日戰役速覽 ===== -->
  <section class="max-w-5xl mx-auto px-4 py-8">
    <h2 class="text-2xl font-serif font-bold text-center text-stone-700 mb-8">
      關鍵四日 · 1949 年 10 月
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      {
        battleDays.map((day) => (
          <a
            href="./timeline"
            class="block bg-white rounded-xl border border-stone-200 p-5 hover:border-amber-300 hover:shadow-md transition-all no-underline group"
          >
            <div class="text-3xl font-bold text-stone-800 group-hover:text-amber-600 transition-colors">
              {day.date}
            </div>
            <div class="text-xs text-stone-400 mt-1">{day.label}</div>
            <h3 class="font-bold text-stone-700 mt-3 text-sm">{day.title}</h3>
            <p class="text-xs text-stone-500 mt-2 line-clamp-3 leading-relaxed">
              {day.description}
            </p>
            <div class="mt-3 text-xs text-amber-600 font-medium">
              {day.events} 個事件 →
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===== 關鍵數字 ===== -->
  <section class="max-w-4xl mx-auto px-4 py-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="bg-white rounded-xl p-6 shadow-sm border border-stone-200">
        <div class="text-3xl font-bold text-amber-600">{STATS.totalTimeline}</div>
        <div class="text-sm text-stone-500 mt-1">時間點</div>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-stone-200">
        <div class="text-3xl font-bold text-amber-600">{STATS.totalEvents}</div>
        <div class="text-sm text-stone-500 mt-1">歷史事件</div>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-stone-200">
        <div class="text-3xl font-bold text-amber-600">{STATS.totalPOIs}</div>
        <div class="text-sm text-stone-500 mt-1">戰役地點</div>
      </div>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-stone-200">
        <div class="text-3xl font-bold text-amber-600">{STATS.totalPersons}</div>
        <div class="text-sm text-stone-500 mt-1">關鍵人物</div>
      </div>
    </div>
  </section>

  <!-- ===== 導航入口 ===== -->
  <section class="max-w-4xl mx-auto px-4 py-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <a href="./context" class="block bg-white p-5 rounded-lg border border-stone-200 hover:border-amber-300 hover:shadow-sm transition-all text-center no-underline group">
        <div class="text-2xl mb-2">🌏</div>
        <div class="font-medium text-stone-800 group-hover:text-amber-700">戰前情勢</div>
        <div class="text-xs text-stone-500 mt-1">1945-1949 國際背景</div>
      </a>
      <a href="./timeline" class="block bg-white p-5 rounded-lg border border-stone-200 hover:border-amber-300 hover:shadow-sm transition-all text-center no-underline group">
        <div class="text-2xl mb-2">⏱️</div>
        <div class="font-medium text-stone-800 group-hover:text-amber-700">時間軸</div>
        <div class="text-xs text-stone-500 mt-1">{STATS.totalTimeline} 條時間點</div>
      </a>
      <a href="./map" class="block bg-white p-5 rounded-lg border border-stone-200 hover:border-amber-300 hover:shadow-sm transition-all text-center no-underline group">
        <div class="text-2xl mb-2">🗺️</div>
        <div class="font-medium text-stone-800 group-hover:text-amber-700">戰役地圖</div>
        <div class="text-xs text-stone-500 mt-1">{STATS.totalPOIs} 個地點</div>
      </a>
      <a href="./locations" class="block bg-white p-5 rounded-lg border border-stone-200 hover:border-amber-300 hover:shadow-sm transition-all text-center no-underline group">
        <div class="text-2xl mb-2">📍</div>
        <div class="font-medium text-stone-800 group-hover:text-amber-700">地點探索</div>
        <div class="text-xs text-stone-500 mt-1">POI 詳情與導覽</div>
      </a>
      <a href="./figures" class="block bg-white p-5 rounded-lg border border-stone-200 hover:border-amber-300 hover:shadow-sm transition-all text-center no-underline group">
        <div class="text-2xl mb-2">👤</div>
        <div class="font-medium text-stone-800 group-hover:text-amber-700">人物誌</div>
        <div class="text-xs text-stone-500 mt-1">{STATS.totalPersons} 位人物</div>
      </a>
      <a href="./stories" class="block bg-white p-5 rounded-lg border border-stone-200 hover:border-amber-300 hover:shadow-sm transition-all text-center no-underline group">
        <div class="text-2xl mb-2">📖</div>
        <div class="font-medium text-stone-800 group-hover:text-amber-700">戰役故事</div>
        <div class="text-xs text-stone-500 mt-1">12 條故事弧線</div>
      </a>
      <a href="./aftermath" class="block bg-white p-5 rounded-lg border border-stone-200 hover:border-amber-300 hover:shadow-sm transition-all text-center no-underline group">
        <div class="text-2xl mb-2">🕊️</div>
        <div class="font-medium text-stone-800 group-hover:text-amber-700">戰後影響</div>
        <div class="text-xs text-stone-500 mt-1">和平反思</div>
      </a>
      <a href="./sources" class="block bg-white p-5 rounded-lg border border-stone-200 hover:border-amber-300 hover:shadow-sm transition-all text-center no-underline group">
        <div class="text-2xl mb-2">📚</div>
        <div class="font-medium text-stone-800 group-hover:text-amber-700">史料來源</div>
        <div class="text-xs text-stone-500 mt-1">{STATS.totalSources} 筆文獻</div>
      </a>
    </div>
  </section>

  <!-- ===== Footer quote ===== -->
  <section class="max-w-3xl mx-auto px-4 pb-16 text-center">
    <div class="border-t border-stone-200 pt-12">
      <p class="font-serif text-lg text-stone-500 italic">
        「歷史無法改變，但和平可以選擇。」
      </p>
    </div>
  </section>
</MainLayout>
