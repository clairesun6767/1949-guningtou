---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeading from '../../components/museum/SectionHeading.astro';
import { perspectiveEvents } from '../../data/perspectiveLoader';
import { UI } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';
const { lang } = Astro.params;
const t = (key: string) => UI[lang as Lang]?.[key] || UI['zh-tw']?.[key] || key;

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}

function tx(obj: Record<string, string> | undefined, fallback: string): string {
  if (!obj) return fallback;
  return (obj as any)[lang] || obj['zh-tw'] || fallback;
}

const VIEW_KEYS: Record<string, string> = {
  roc: 'rocAccounts',
  pla: 'plaAccounts',
  civilian: 'civilianMemory',
};

const STATUS_KEYS: Record<string, string> = {
  verified: 'verified',
  partially_verified: 'partiallyVerified',
  disputed: 'disputed',
  oral_accounts: 'oralAccounts',
  politically_contested: 'politicallyContested',
};
---

<MainLayout lang={lang}>
  <div class="museum-page">
    <div class="museum-container">
      <SectionHeading level={1} index="01" eyebrow="MULTIPLE PERSPECTIVES" title="多元史觀" description="同一場戰役，不同位置的人留下不同的記憶。選擇事件，比較各方記載，並把史料差異保留在閱讀現場。" />

    <nav class="museum-anchor-list" aria-label="事件索引">
      {perspectiveEvents.map(evt => (
        <a href={`#${evt.id}`} class="museum-anchor-link">
          {tx(evt.title, evt.id)}
        </a>
      ))}
    </nav>

    {perspectiveEvents.map(evt => (
      <section id={evt.id} class="museum-perspective-section">
        <div class="museum-perspective-card">
          <div class="museum-perspective-card__header">
            <div class="flex items-center justify-between">
              <h2 class="museum-perspective-card__title">{tx(evt.title, evt.id)}</h2>
              {evt.evidenceStatus && (
                <span class={`museum-status-badge ${
                  evt.evidenceStatus === 'disputed' ? 'bg-red-50 text-red-600' :
                  evt.evidenceStatus === 'verified' ? 'bg-green-50 text-green-600' :
                  evt.evidenceStatus === 'partially_verified' ? 'bg-amber-50 text-amber-600' :
                  evt.evidenceStatus === 'politically_contested' ? 'bg-purple-50 text-purple-600' :
                  'bg-stone-50 text-stone-600'
                }`}>
                  {t(STATUS_KEYS[evt.evidenceStatus] || evt.evidenceStatus)}
                </span>
              )}
            </div>
            <p class="museum-perspective-card__summary">{tx(evt.summary, '')}</p>
          </div>

          <div class="museum-perspective-grid">
            {Object.entries(evt.viewpoints).map(([key, vp]) => (
              <div class={`museum-perspective-view museum-perspective-view--${key}`}>
                <div class="museum-perspective-view__label">
                  <span class="museum-perspective-dot" />
                  <span>{t(VIEW_KEYS[key] || key)}</span>
                </div>
                <p class="museum-perspective-view__body">{tx(vp, '')}</p>
              </div>
            ))}
          </div>

          {evt.disputes && evt.disputes.length > 0 && (
            <div class="museum-perspective-card__disputes">
              <h3>史料差異</h3>
              <div class="museum-perspective-card__dispute-list">
                {evt.disputes.map(d => (
                  <div class="museum-perspective-card__dispute">
                    <span>•</span>
                    <div>
                      <span class="font-medium text-stone-700">{d.topic}：</span>
                      <span class="text-stone-600">{tx(d as any, d.topic)}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    ))}

    <div class="museum-callout museum-callout--archive museum-callout--small">
      <h3 class="museum-callout__title">研究方法</h3>
      <p>每個事件的「國軍記載」主要引用國防部戰史與金門國家公園史料。「解放軍記載」引用解放軍戰史與軍事科學院編纂史料。「居民記憶」來自金門地方口述歷史採集。爭議事項已明確標示，讀者可自行對照各方原始出處。</p>
    </div>
    </div>
  </div>
</MainLayout>
