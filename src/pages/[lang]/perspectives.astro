---
import MainLayout from '../../layouts/MainLayout.astro';
import { sitePath } from '../../data/paths';
import { perspectiveEvents } from '../../data/perspectiveLoader';
import { UI } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';
const { lang } = Astro.params;
const t = (key: string) => UI[lang as Lang]?.[key] || UI['zh-tw']?.[key] || key;

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-tw' } },
    { params: { lang: 'zh-cn' } },
    { params: { lang: 'en' } },
  ];
}

function tx(obj: Record<string, string> | undefined, fallback: string): string {
  if (!obj) return fallback;
  return (obj as any)[lang] || obj['zh-tw'] || fallback;
}

const VIEW_KEYS: Record<string, string> = {
  roc: 'rocAccounts',
  pla: 'plaAccounts',
  civilian: 'civilianMemory',
};

const STATUS_KEYS: Record<string, string> = {
  verified: 'verified',
  partially_verified: 'partiallyVerified',
  disputed: 'disputed',
  oral_accounts: 'oralAccounts',
  politically_contested: 'politicallyContested',
};
---

<MainLayout lang={lang}>
  <div class="max-w-5xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-serif font-bold mb-2">多元史觀</h1>
    <p class="text-stone-500 mb-10">同一場戰役，不同位置的人留下不同的記憶。選擇事件，比較各方記載。</p>

    <div class="flex flex-wrap gap-2 mb-10">
      {perspectiveEvents.map(evt => (
        <a href={`#${evt.id}`} class="px-4 py-2 bg-white border border-stone-200 rounded-lg text-sm text-stone-600 hover:border-amber-300 hover:text-amber-700 no-underline transition">
          {tx(evt.title, evt.id)}
        </a>
      ))}
    </div>

    {perspectiveEvents.map(evt => (
      <section id={evt.id} class="mb-12 scroll-mt-20">
        <div class="bg-white rounded-xl border border-stone-200 overflow-hidden">
          <div class="bg-stone-50 px-6 py-4 border-b border-stone-200">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-serif font-bold text-stone-800">{tx(evt.title, evt.id)}</h2>
              {evt.evidenceStatus && (
                <span class={`text-xs px-2 py-1 rounded ${
                  evt.evidenceStatus === 'disputed' ? 'bg-red-50 text-red-600' :
                  evt.evidenceStatus === 'verified' ? 'bg-green-50 text-green-600' :
                  evt.evidenceStatus === 'partially_verified' ? 'bg-amber-50 text-amber-600' :
                  evt.evidenceStatus === 'politically_contested' ? 'bg-purple-50 text-purple-600' :
                  'bg-stone-50 text-stone-600'
                }`}>
                  {t(STATUS_KEYS[evt.evidenceStatus] || evt.evidenceStatus)}
                </span>
              )}
            </div>
            <p class="text-sm text-stone-500 mt-1">{tx(evt.summary, '')}</p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-stone-200">
            {Object.entries(evt.viewpoints).map(([key, vp]) => (
              <div class="bg-white p-5">
                <div class="flex items-center gap-2 mb-3">
                  {key === 'roc' && <span class="w-2.5 h-2.5 rounded-full bg-blue-600 shrink-0" />}
                  {key === 'pla' && <span class="w-2.5 h-2.5 rounded-full bg-red-600 shrink-0" />}
                  {key === 'civilian' && <span class="w-2.5 h-2.5 rounded-full bg-green-600 shrink-0" />}
                  <span class="text-xs font-bold text-stone-600">{t(VIEW_KEYS[key] || key)}</span>
                </div>
                <p class="text-sm text-stone-700 leading-relaxed">{tx(vp, '')}</p>
              </div>
            ))}
          </div>

          {evt.disputes && evt.disputes.length > 0 && (
            <div class="border-t border-stone-200 px-6 py-4 bg-amber-50/50">
              <h3 class="text-xs font-bold text-amber-700 uppercase tracking-wide mb-2">史料差異</h3>
              <div class="space-y-2">
                {evt.disputes.map(d => (
                  <div class="flex gap-2 text-sm">
                    <span class="text-amber-400 mt-0.5">•</span>
                    <div>
                      <span class="font-medium text-stone-700">{d.topic}：</span>
                      <span class="text-stone-600">{tx(d as any, d.topic)}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    ))}

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 text-sm text-amber-700">
      <h3 class="font-bold mb-1">研究方法</h3>
      <p>每個事件的「國軍記載」主要引用國防部戰史與金門國家公園史料。「解放軍記載」引用解放軍戰史與軍事科學院編纂史料。「居民記憶」來自金門地方口述歷史採集。爭議事項已明確標示，讀者可自行對照各方原始出處。</p>
    </div>
  </div>
</MainLayout>
