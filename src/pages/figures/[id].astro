---
import MainLayout from '../../layouts/MainLayout.astro';
import { persons } from '../../data/loader';

export function getStaticPaths() {
  return persons.map((p) => ({
    params: { id: p.person_id },
  }));
}

const { id } = Astro.params;
const person = persons.find((p) => p.person_id === id);
---

<MainLayout>
  {person ? (
    <div class="max-w-3xl mx-auto px-4 py-16">
      <a href="./figures" class="text-sm text-stone-500 hover:text-stone-700 no-underline">&larr; 回到人物列表</a>
      <h1 class="text-3xl font-serif font-bold mt-4 mb-1">{person.name_zh}</h1>
      {person.name_en && <p class="text-stone-400 mb-4">{person.name_en}</p>}

      <div class="bg-white rounded-xl border border-stone-200 p-6 mb-6">
        <h2 class="font-semibold text-sm text-stone-500 uppercase tracking-wide mb-2">簡介</h2>
        <p class="text-stone-700 leading-relaxed">{person.biographical_summary ?? person.standard_bio ?? '尚無詳細資料'}</p>
      </div>

      <div class="grid grid-cols-2 gap-4 text-sm">
        <div class="bg-white rounded-lg border border-stone-200 p-4">
          <span class="text-stone-400">陣營</span>
          <div>{person.primary_category ?? '未知'}</div>
        </div>
        <div class="bg-white rounded-lg border border-stone-200 p-4">
          <span class="text-stone-400">軍階</span>
          <div>{person.rank_at_event ?? '未知'}</div>
        </div>
        <div class="bg-white rounded-lg border border-stone-200 p-4">
          <span class="text-stone-400">單位</span>
          <div>{person.unit ?? '未知'}</div>
        </div>
        <div class="bg-white rounded-lg border border-stone-200 p-4">
          <span class="text-stone-400">生卒</span>
          <div>{person.birth_date ?? '?'} – {person.death_date ?? '?'}</div>
        </div>
      </div>
    </div>
  ) : (
    <div class="max-w-3xl mx-auto px-4 py-16 text-center">
      <h1 class="text-2xl font-bold text-stone-700">人物不存在</h1>
      <a href="./figures" class="text-amber-600">回到人物列表</a>
    </div>
  )}
</MainLayout>
