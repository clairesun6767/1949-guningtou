# build output
dist/
.tmp/
.astro/

# local caches and generated tooling state
.cache/
.vite/
cache/
coverage/
tmp/

# Gate A.3P source cache and high-detail review assets remain local-only.
/.local/aerial-poc/
# Public publication keeps only the explicitly authorized low-resolution Kinmen bundle.
/public/.local/aerial-poc/guningtou/
/public/.local/aerial-poc/screenshots/
/public/.local/aerial-poc/xiamen/
# Xiamen candidate pixels remain local-only; the public folder stores metadata only.
/public/research/xiamen-1943/*.jpg

# desktop attachment staging area; keep private source documents out of Git
.hermes/
.codex-remote-attachments/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables and local secrets
.env
.env.*
!.env.example

# logs and local reports
*.log

# raw geospatial inputs are not publishable project assets;
# commit only the derived, documented public terrain assets.
*.dem
*.hgt
*.tif
*.tiff
*.geotiff
*.img
*.asc
*.bil
*.vrt
*.las
*.laz
*.gpkg
*.pbf
*.mbtiles

